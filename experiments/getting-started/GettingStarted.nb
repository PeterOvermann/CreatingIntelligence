Cell["\<\
The left-hand side of a heteroassociation A -> B can be partitioned into \
blocks. Here we set up a dataflow with a bipartite input. The pattern \
matching threshold T is configured to be greater than the population of a \
single partition: \
\>", "Text",ExpressionUUID->"856b6661-c990-4341-8725-45a22fc35a9b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dataflow", "[", 
  RowBox[{
   RowBox[{"{", " ", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"input", "[", "codec", "]"}], " ", "[", "11", "]"}], " ", "[", 
      "]"}], ",", " ", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"input", "[", "codec", "]"}], " ", "[", "12", "]"}], " ", "[", 
      "]"}], ",", " ", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"input", "[", "codec", "]"}], " ", "[", "21", "]"}], " ", "[", 
      "]"}], ",", " ", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"associator", "[", 
        RowBox[{"\"\<threshold\>\"", "->", "0.6"}], "]"}], " ", "[", "101", 
       "]"}], " ", "[", 
      RowBox[{"21", ",", " ", "11", ",", " ", "12"}], "]"}], ",", "\n", "\t", 
     
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "codec", "]"}], " ", "[", "]"}], " ", "[", 
      "101", "]"}], ",", "\n", "\t", 
     RowBox[{"_", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "10"}], "}"}]}]}], "\n", "\t", "}"}], ",", 
   " ", "240"}], "  ", "]"}]], "Code",
 CellLabel->
  "In[5451]:=",ExpressionUUID->"2e432e3a-7a4b-4072-ab93-6abc27d574d9"],

Cell[BoxData[
 FrameBox[
  TagBox[GridBox[{
     {
      StyleBox[
       TagBox["\<\"{ \\\"hyperparameters\\\": {\\\"default\\\": [1000, \
10]},\\n  \\\"dataflow\\\": [\\n\\t{\\\"component\\\": \\\"input\\\", \
\\\"plugin\\\": \\\"codec\\\", \\\"send\\\": [11]},\\n\\t{\\\"component\\\": \
\\\"input\\\", \\\"plugin\\\": \\\"codec\\\", \\\"send\\\": \
[12]},\\n\\t{\\\"component\\\": \\\"input\\\", \\\"plugin\\\": \\\"codec\\\", \
\\\"send\\\": [21]},\\n\\t{\\\"component\\\": \\\"associator\\\", \
\\\"send\\\": [101], \\\"receive\\\": [21, 11, 12], \\\"threshold\\\": \
0.6},\\n\\t{\\\"component\\\": \\\"output\\\", \\\"plugin\\\": \\\"codec\\\", \
\\\"receive\\\": [101]}\\n  ]}\"\>",
        Function[BoxForm`e$, 
         TableForm[BoxForm`e$, TableSpacing -> {2, 1}]]],
       StripOnInput->False,
       LineColor->GrayLevel[0],
       FrontFaceColor->GrayLevel[0],
       BackFaceColor->GrayLevel[0],
       GraphicsColor->GrayLevel[0],
       FontFamily->"JetBrains Mono",
       FontSize->10,
       FontColor->GrayLevel[0]]},
     {
      TemplateBox[{10, 5},
       "Spacer2"]},
     {
      TemplateBox[{
        TemplateBox[{18}, "Spacer1"], 
        StyleBox[
         GraphicsBox[
          NamespaceBox["NetworkGraphics", 
           DynamicModuleBox[{Typeset`graph = HoldComplete[
               
               Graph[{3, 4, 1, 2, 
                5}, {{{1, 2}, {3, 2}, {4, 2}, {2, 5}}, Null, {
                 "", "", "", ""}}, {
                BaseStyle -> {FontFamily -> "Inter Variable", 
