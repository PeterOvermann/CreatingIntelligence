   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"updaterule\"\>", "\[Rule]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Complement", "[", 
         RowBox[{"#1", ",", "#2"}], "]"}], "&"}], ")"}]}], ",", 
