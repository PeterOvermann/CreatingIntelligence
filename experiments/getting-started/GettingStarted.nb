Cell["\<\
The total dimension of the input blocks must match the total dimension of \
outputs:\
\>", "Text",ExpressionUUID->"874679f6-152a-40ff-ae4a-0ebd9c825ca2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dataflow", "[", 
  RowBox[{
   RowBox[{"{", "\n", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"input", "[", "]"}], "[", "11", "]"}], "[", "]"}], ",", " ", 
     "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"input", "[", "]"}], "[", "12", "]"}], "[", "]"}], ",", " ", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"delay", "[", "]"}], "[", 
       RowBox[{"101", ",", "102"}], "]"}], "[", 
      RowBox[{
       RowBox[{"11", "\"\<$\>\""}], ",", " ", 
       RowBox[{"12", "\"\<$\>\""}]}], "]"}], ",", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "]"}], "[", "]"}], "[", 
      RowBox[{"101", "\"\<$\>\""}], "]"}], ",", " ", "\n", "\t", 
     RowBox[{
