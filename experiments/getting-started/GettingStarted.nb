      " ", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"auto", "[", "replacement", "]"}], " ", "[", "21", "]"}], " ", 
      "[", "11", "]"}], ",", " ", "\n", "\t", 
