\\\"send\\\": [11]},\\n\\t{\\\"component\\\": \\\"auto\\\", \\\"send\\\": \
[21], \\\"receive\\\": [11], \\\"threshold\\\": \
1.0},\\n\\t{\\\"component\\\": \\\"output\\\", \\\"receive\\\": [21]}\\n  \
]}\"\>",
