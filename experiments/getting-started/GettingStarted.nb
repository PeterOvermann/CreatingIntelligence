              RowBox[{"20", ",", "0"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"5", ",", "5"}], "}"}]}], "}"}]}]}], "]"}], "}"}], 
       "]"}]}]}], "\[IndentingNewLine]", "\t", "]"}]}], ";"}]}], "Code",
