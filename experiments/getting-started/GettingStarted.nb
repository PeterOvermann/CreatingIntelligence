       RowBox[{"noise", "[", "]"}], "[", "11", "]"}], "[", "]"}], ",", " ", 
     "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "]"}], "[", "]"}], "[", "11", "]"}], ",", "\n", 
     "\t", 
     RowBox[{"_", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "5"}], "}"}]}]}], "\n", "\t", "}"}], ",", 
   " ", "120"}], "]"}]], "Code",
 CellLabel->
  "In[307]:=",ExpressionUUID->"587a4095-3e38-4ffa-b602-857248cdf7b0"],

