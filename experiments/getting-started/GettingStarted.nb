      RowBox[{
       RowBox[{"output", "[", "]"}], " ", "[", "]"}], " ", "[", "21", "]"}], ",",
      "\n", "\t", 
     RowBox[{"_", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "10"}], "}"}]}]}], "\n", "\t", "}"}], ",", 
