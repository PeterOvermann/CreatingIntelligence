       RowBox[{
        RowBox[{"11", "\"\<!\>\""}], ",", " ", "22"}], "}"}], "]"}], ",", 
     "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"delay", "[", "]"}], "[", "22", "]"}], "[", "21", "]"}], ",", 
