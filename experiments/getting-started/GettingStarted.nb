         RowBox[{"\"\<categories\>\"", "->", "10"}]}], "]"}], "[", "11", 
       "]"}], "[", "]"}], ",", " ", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "]"}], "[", "]"}], "[", "11", "]"}], ",", " ", 
     "\n", "\t", 
