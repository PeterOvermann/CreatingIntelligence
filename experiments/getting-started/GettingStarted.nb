Cell[CellGroupData[{

Cell["Multiplexing and Temporal Gating", "Section",ExpressionUUID->"fafa2d3f-f7ea-423c-9e4f-c9d296ef16f8"],

Cell["\<\
By default, invoking a circuit\[CloseCurlyQuote]s function triggers one \
evaluation cycle. Multiple cycles with the same input,  or alternatively with \
zero inputs (an empty list for each function argument) can be  triggered  by \
setting the \[OpenCurlyDoubleQuote]multiplex\[CloseCurlyDoubleQuote] option \
in the circuit\[CloseCurlyQuote]s dataflow description. The multiplexing \
specification is a list of integers 0 or 1. Each 1 triggers an evaluation \
cycle with the same repeated input. Each 0 triggers a cycle with empty \
inputs, during which only the circuit-internal state is processed.\
\>", "Text",ExpressionUUID->"3c0da086-2afa-4a30-8ae7-91fbb9071a89"],

Cell["\<\
This circuit triggers three cycles with the same input. We tag the path with \
\[OpenCurlyDoubleQuote]log\[CloseCurlyDoubleQuote] to inspect the dataflow:\
\>", "Text",ExpressionUUID->"79016725-eb80-41cc-9f8e-2b194104ca26"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dataflow", "[", 
  RowBox[{
   RowBox[{"{", "\n", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"input", "[", "]"}], " ", "[", "11", "]"}], " ", "[", "]"}], ",",
      " ", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "]"}], " ", "[", "]"}], " ", "[", 
      RowBox[{"11", "\"\<?\>\""}], "]"}], ",", "\n", "\t", 
     RowBox[{"_", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "5"}], "}"}]}], ",", "\n", "\t", 
     RowBox[{"\"\<multiplex\>\"", " ", "->", " ", "\"\<111\>\""}]}], "\n", 
    "\t", "}"}], ",", " ", "120"}], "]"}]], "Code",
 CellLabel->
  "In[3158]:=",ExpressionUUID->"e3ddacc9-33d6-4188-ace1-b91442ac3f82"],

