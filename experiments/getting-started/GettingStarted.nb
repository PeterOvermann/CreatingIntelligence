     "                      ", "\n", "        ", 
     RowBox[{"(*", " ", 
      RowBox[{"Verify", " ", "DFD", " ", 
       RowBox[{"Export", "/", "Import"}], " ", 
       RowBox[{"roundtrip", "."}]}], " ", "*)"}], "\n", "\n", "        ", 
     RowBox[{"dfdstr", " ", "=", " ", 
      RowBox[{"ExportString", "[", " ", 
       RowBox[{"data", ",", " ", "\"\<Package\>\""}], "]"}]}], ";", 
     "                            ", "\n", "        ", 
     RowBox[{"circuit", " ", "=", " ", 
      RowBox[{"ImportString", "[", 
       RowBox[{"dfdstr", ",", " ", "\"\<CircuitDFD\>\""}], "]"}]}], ";", " ", 
     "\n", "        ", 
     RowBox[{"dfdexpr", " ", "=", " ", 
      RowBox[{"ImportString", "[", " ", 
       RowBox[{
        RowBox[{"ExportString", "[", 
         RowBox[{"circuit", ",", " ", "\"\<CircuitDFD\>\""}], "]"}], ",", 
        " ", "\"\<CircuitDFD\>\""}], "]"}]}], ";", "\n", "  ", "\n", 
     "  \t   ", 
     RowBox[{"If", "[", " ", 
      RowBox[{
       RowBox[{"circuit", " ", "=!=", " ", "dfdexpr"}], ",", " ", "\n", 
       "\t\t\t", 
       RowBox[{
        RowBox[{"++", " ", "ERRORCOUNT"}], ";", "\n", "\t\t\t", 
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"Circuit", "::", "regress"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"circuit", ",", " ", "dfdexpr"}], "}"}]}], "]"}], ";"}]}], 
      "\n", "\t\t\t", "]"}], ";", "\n", "             ", "\n", "        ", 
     RowBox[{"(*", " ", 
      RowBox[{"Verify", " ", "JSON", " ", 
       RowBox[{"Export", "/", "Import"}], " ", 
       RowBox[{"roundtrip", "."}]}], " ", "*)"}], "\n", "\n", "        ", 
     RowBox[{"jsonstr", " ", "=", " ", 
      RowBox[{"ExportString", "[", 
       RowBox[{"circuit", ",", " ", "\"\<Circuit\>\""}], "]"}]}], ";", "   ", 
     "\n", "        ", 
     RowBox[{"exprimport", " ", "=", " ", 
      RowBox[{"ImportString", "[", 
