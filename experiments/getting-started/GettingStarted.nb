      RowBox[{
       RowBox[{"input", "[", "]"}], "[", "11", "]"}], "[", "]"}], ",", " ", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"delay", "[", 
        RowBox[{"latch", ",", " ", 
         RowBox[{"\"\<capacity\>\"", "->", "1"}], ",", " ", 
         RowBox[{"\"\<threshold\>\"", " ", "->", " ", "0.8"}]}], "]"}], "[", 
       "21", "]"}], "[", "11", "]"}], ",", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "]"}], "[", "]"}], "[", "21", "]"}], ",", "\n", 
     "\t", 
