     "                      ", "\n", "        ", 
     RowBox[{"(*", " ", 
      RowBox[{"Verify", " ", "DFD", " ", 
       RowBox[{"Export", "/", "Import"}], " ", 
       RowBox[{"roundtrip", "."}]}], " ", "*)"}], "\n", "\n", "        ", 
     RowBox[{"dfdstr", " ", "=", " ", 
      RowBox[{"ExportString", "[", " ", 
       RowBox[{"data", ",", " ", "\"\<Package\>\""}], "]"}]}], ";", 
     "                            ", "\n", "        ", 
     RowBox[{"circuit", " ", "=", " ", 
      RowBox[{"ImportString", "[", 
       RowBox[{"dfdstr", ",", " ", "\"\<CircuitDFD\>\""}], "]"}]}], ";", " ", 
     "\n", "        ", 
     RowBox[{"dfdexpr", " ", "=", " ", 
      RowBox[{"ImportString", "[", " ", 
       RowBox[{
        RowBox[{"ExportString", "[", 
