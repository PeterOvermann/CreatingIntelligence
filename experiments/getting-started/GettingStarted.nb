\\\"input\\\", \\\"plugin\\\": \\\"codec\\\", \\\"send\\\": \
[21]},\\n\\t{\\\"component\\\": \\\"predictor\\\", \\\"send\\\": [101], \
\\\"receive\\\": [11, 21]},\\n\\t{\\\"component\\\": \\\"output\\\", \
\\\"plugin\\\": \\\"codec\\\", \\\"receive\\\": [101]}\\n  ]}\"\>",
        Function[BoxForm`e$, 
         TableForm[BoxForm`e$, TableSpacing -> {2, 1}]]],
       StripOnInput->False,
       LineColor->GrayLevel[0],
