Cell["Veto signals", "Subsubsection",ExpressionUUID->"f02efc3d-008c-4082-992f-428d1f224542"],

Cell["\<\
A path tagged with \[OpenCurlyDoubleQuote]veto\[CloseCurlyDoubleQuote] acts \
as a veto signal: If it contains any element, the entire bundle becomes zero:\
\
\>", "Text",ExpressionUUID->"02aa8521-ce3b-4b66-804e-2dd3bc7827de"],

