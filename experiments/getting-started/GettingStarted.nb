     RowBox[{"CIRCUITCOUNT", "++"}], ";", "\n", "        ", "\n", "\t\t", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"Magnify", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"CIRCUIT", "[", "\"\<schematics\>\"", "]"}], "[", 
