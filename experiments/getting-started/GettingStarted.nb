Cell[BoxData[{
 RowBox[{
  RowBox[{"ERRORCOUNT", " ", "=", " ", 
   RowBox[{"TESTCOUNT", " ", "=", " ", 
    RowBox[{"CIRCUITCOUNT", " ", "=", " ", "0"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "test", "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"test", "[", "x___", "]"}], "[", "pattern___", "]"}], " ", ":=", 
   " ", 
   RowBox[{"Module", "[", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"str", ",", " ", 
       RowBox[{"width", " ", "=", " ", "600"}], ",", " ", "tostring", ",", 
       " ", "result"}], "}"}], ",", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"tostring", "[", "s___", "]"}], " ", ":=", " ", 
       RowBox[{"StringRiffle", "[", " ", 
        RowBox[{
         RowBox[{"ToString", " ", "/@", " ", 
          RowBox[{"{", "s", "}"}]}], ",", " ", "\"\<, \>\""}], "]"}]}], ";", 
      "\n", "\t", 
      RowBox[{"result", " ", "=", " ", 
       RowBox[{
        RowBox[{"CIRCUIT", "[", "\"\<function\>\"", "]"}], "[", "x", "]"}]}], 
      ";", "\n", "\t", 
      RowBox[{"str", " ", "=", " ", 
       RowBox[{"\"\<> \>\"", " ", "<>", " ", 
        RowBox[{"tostring", "[", "x", "]"}], " ", "<>", " ", "\"\<\\n\>\"", 
        " ", "<>", " ", 
        RowBox[{"tostring", "[", "result", "]"}]}]}], ";", 
      "\[IndentingNewLine]", "\n", "\t", 
      RowBox[{"TESTCOUNT", "++"}], ";", "\n", "\t", 
      RowBox[{"If", "[", " ", 
       RowBox[{
        RowBox[{"!", " ", 
         RowBox[{"MatchQ", "[", " ", 
          RowBox[{
           RowBox[{"{", "result", "}"}], ",", " ", 
           RowBox[{"{", "pattern", "}"}]}], "]"}]}], ",", " ", "\n", "\t\t", 
        RowBox[{
         RowBox[{"++", " ", "ERRORCOUNT"}], ";", "\n", "\t\t", 
         RowBox[{"Message", "[", 
          RowBox[{
           RowBox[{"Circuit", "::", "regress"}], ",", " ", 
           RowBox[{"{", "pattern", "}"}]}], "]"}], ";"}]}], "\n", "\t\t", 
       "]"}], ";", "\n", "\n", "\t", 
      RowBox[{"Column", "[", " ", 
       RowBox[{"{", "\[IndentingNewLine]", "\t\t", 
        RowBox[{"Framed", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"str", ",", " ", 
            RowBox[{"FontFamily", " ", "->", " ", "codefontfamily"}], ",", 
            " ", 
            RowBox[{"Circuit`color", "[", "0", "]"}], ",", "\n", "\t\t", 
            RowBox[{"FontSize", " ", "->", " ", "codefontsize"}]}], "]"}], ",",
           " ", 
          RowBox[{"ImageSize", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"width", ",", " ", "Automatic"}], "}"}]}], ",", "\n", 
          "\t\t", 
          RowBox[{"Background", " ", "->", " ", 
           RowBox[{"Circuit`color", "[", "6", "]"}]}], ",", " ", 
          RowBox[{"FrameStyle", " ", "->", " ", "None"}], ",", " ", 
          RowBox[{"FrameMargins", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"20", ",", "0"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"5", ",", "5"}], "}"}]}], "}"}]}]}], "]"}], "}"}], 
       "]"}]}]}], "\[IndentingNewLine]", "\t", "]"}]}], ";"}]}], "Code",
 CellLabel->"In[9]:=",ExpressionUUID->"92d59577-0400-485b-b20e-2f24d370606d"],

Cell[TextData[{
 "The",
 StyleBox[" Creating Intelligence",
  FontSlant->"Italic"],
 " project develops a computational framework for AGI, framed in set theory \
and designed around population coding and topological associative memory.  \
This document is a practical  introduction to designing macro-scale neural \
circuits within this framework. Circuits represent stateful machines that \
process hyperdimensional sparse distributed representations (SDRs) and sparse \
holographic representations (SHRs)."
}], "Text",ExpressionUUID->"87579e7b-f6a0-41f8-82c2-9eb95fc7b7df"],

Cell["\<\
A JSON dataflow description language  fully specifies circuits composed of \
standardized building blocks:\
\>", "Text",ExpressionUUID->"ff9293d6-529a-4cc5-b93f-c817ac552344"],

