Cell[BoxData[{
 RowBox[{
  RowBox[{"ERRORCOUNT", " ", "=", " ", 
   RowBox[{"TESTCOUNT", " ", "=", " ", 
    RowBox[{"CIRCUITCOUNT", " ", "=", " ", "0"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "test", "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"test", "[", "x___", "]"}], "[", "pattern___", "]"}], " ", ":=", 
   " ", 
   RowBox[{"Module", "[", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"str", ",", " ", 
       RowBox[{"width", " ", "=", " ", "600"}], ",", " ", "tostring", ",", 
       " ", "result"}], "}"}], ",", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"tostring", "[", "s___", "]"}], " ", ":=", " ", 
       RowBox[{"StringRiffle", "[", " ", 
        RowBox[{
         RowBox[{"ToString", " ", "/@", " ", 
          RowBox[{"{", "s", "}"}]}], ",", " ", "\"\<, \>\""}], "]"}]}], ";", 
      "\n", "\t", "\n", "\t", 
      RowBox[{"(*", " ", 
       RowBox[{"Collect", " ", "test", " ", 
        RowBox[{"cases", "."}]}], " ", "*)"}], "\n", "\t", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"CASES", ",", " ", 
        RowBox[{
         RowBox[{"<|", " ", 
          RowBox[{
           RowBox[{"\"\<input\>\"", " ", "->", " ", 
            RowBox[{"{", "x", "}"}]}], ",", " ", 
           RowBox[{"\"\<output\>\"", " ", "->", " ", 
            RowBox[{"{", "pattern", "}"}]}]}], " ", "|>"}], " ", "/.", " ", 
         "\n", "\t\t", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Verbatim", "[", "_", "]"}], " ", "->", 
            " ", "\"\<_\>\""}], ",", " ", 
           RowBox[{
            RowBox[{"Verbatim", "[", "__", "]"}], " ", "->", 
            " ", "\"\<__\>\""}]}], "}"}]}]}], "]"}], ";", "\n", "\t", "\n", 
      "\t", 
      RowBox[{"result", " ", "=", " ", 
       RowBox[{
        RowBox[{"CIRCUIT", "[", "\"\<function\>\"", "]"}], "[", "x", "]"}]}], 
      ";", "\n", "\t", 
      RowBox[{"str", " ", "=", " ", 
       RowBox[{"\"\<> \>\"", " ", "<>", " ", 
        RowBox[{"tostring", "[", "x", "]"}], " ", "<>", " ", "\"\<\\n\>\"", 
        " ", "<>", " ", 
        RowBox[{"tostring", "[", "result", "]"}]}]}], ";", 
      "\[IndentingNewLine]", "\n", "\t", 
      RowBox[{"TESTCOUNT", "++"}], ";", "\n", "\t", "\n", "\t", 
      RowBox[{"If", "[", " ", 
       RowBox[{
        RowBox[{"!", " ", 
         RowBox[{"MatchQ", "[", " ", 
          RowBox[{
           RowBox[{"{", "result", "}"}], ",", " ", 
