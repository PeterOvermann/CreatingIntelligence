Cell[CellGroupData[{

Cell["Supervised Learning with Heteroassociations", "Section",ExpressionUUID->"1d99a2fe-40d2-4fca-8aa6-88f9781f2ca8"],

Cell["\<\
The \[OpenCurlyDoubleQuote]associator\[CloseCurlyDoubleQuote] node implements \
a basic hetero-associative memory for supervised learning applications. It \
stores associations of the form A->B, where A and B are typically sets from \
different spaces with different hyperparameters.\
\>", "Text",ExpressionUUID->"ca96f88b-55cc-4bce-a087-5ce23c164ef3"],

Cell["\<\
Heteroassociations may involve perceptual (SDR) or symbolic (SHR) data. \
\>", "Text",ExpressionUUID->"433fdc36-b458-416a-8830-6884a51d0251"],

Cell["\<\
This basic example demonstrates heteroassociations between symbolic \
representations. Note that the training signal (B) is the first argument of \
the associator node:\
\>", "Text",ExpressionUUID->"615bc8b4-0bdf-4416-ae30-842f7723eb54"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dataflow", "[", 
  RowBox[{
   RowBox[{"{", " ", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"input", "[", "codec", "]"}], " ", "[", "11", "]"}], " ", "[", 
      "]"}], ",", " ", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"input", "[", "codec", "]"}], " ", "[", "21", "]"}], " ", "[", 
      "]"}], ",", " ", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"associator", "[", "]"}], " ", "[", "101", "]"}], " ", "[", 
      RowBox[{"21", ",", " ", "11"}], "]"}], ",", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "codec", "]"}], " ", "[", "]"}], " ", "[", 
      "101", "]"}], ",", "\n", "\t", 
     RowBox[{"11", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "10"}], "}"}]}], ",", "\n", "\t", 
     RowBox[{"_", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1500", ",", " ", "15"}], "}"}]}]}], "\n", "\t", "}"}], ",", 
   " ", "240"}], "  ", "]"}]], "Code",
 CellLabel->
  "In[3323]:=",ExpressionUUID->"c1f93adb-bc77-4b12-9645-3d07b4e656d8"],

Cell[BoxData[
 FrameBox[
  TagBox[GridBox[{
     {
      StyleBox[
       TagBox["\<\"{ \\\"hyperparameters\\\": {\\\"11\\\": [1000, 10], \
\\\"default\\\": [1500, 15]},\\n  \\\"dataflow\\\": \
[\\n\\t{\\\"component\\\": \\\"input\\\", \\\"plugin\\\": \\\"codec\\\", \
\\\"send\\\": [11]},\\n\\t{\\\"component\\\": \\\"input\\\", \\\"plugin\\\": \
\\\"codec\\\", \\\"send\\\": [21]},\\n\\t{\\\"component\\\": \\\"associator\\\
\", \\\"send\\\": [101], \\\"receive\\\": [21, 11]},\\n\\t{\\\"component\\\": \
\\\"output\\\", \\\"plugin\\\": \\\"codec\\\", \\\"receive\\\": [101]}\\n  ]}\
\"\>",
        Function[BoxForm`e$, 
         TableForm[BoxForm`e$, TableSpacing -> {2, 1}]]],
       StripOnInput->False,
       LineColor->GrayLevel[0],
       FrontFaceColor->GrayLevel[0],
       BackFaceColor->GrayLevel[0],
       GraphicsColor->GrayLevel[0],
       FontFamily->"JetBrains Mono",
       FontSize->10,
       FontColor->GrayLevel[0]]},
     {
      TemplateBox[{10, 5},
       "Spacer2"]},
     {
      TemplateBox[{
        TemplateBox[{18}, "Spacer1"], 
        StyleBox[
         GraphicsBox[
          NamespaceBox["NetworkGraphics", 
           DynamicModuleBox[{Typeset`graph = HoldComplete[
               
               Graph[{2, 3, 1, 
                4}, {{{1, 2}, {3, 2}, {2, 4}}, Null, {"", "", ""}}, {
                BaseStyle -> {FontFamily -> "Inter Variable", 
                   Opacity[1]}, 
                 EdgeLabels -> {
                  DirectedEdge[3, 4, ""] -> None, DirectedEdge[1, 3, ""] -> 
                   None, DirectedEdge[2, 3, ""] -> None}, 
                 EdgeStyle -> {DirectedEdge[2, 3, ""] -> Directive[
                    RGBColor[
                    0.1803921568627451, 0.20392156862745098`, 
                    0.25098039215686274`], 
                    Opacity[1], 
                    AbsoluteThickness[0.5]], DirectedEdge[3, 4, ""] -> 
                   Directive[
                    RGBColor[
                    0.1803921568627451, 0.20392156862745098`, 
                    0.25098039215686274`], 
                    Opacity[1], 
                    AbsoluteThickness[0.5]], DirectedEdge[1, 3, ""] -> 
                   Directive[
                    RGBColor[
                    0.1803921568627451, 0.20392156862745098`, 
                    0.25098039215686274`], 
                    Opacity[1], 
