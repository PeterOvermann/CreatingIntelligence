        "0.8"}], "]"}]}], ";", "\n", "\t\t", "\n", "\t\t", 
     RowBox[{"str", " ", "=", " ", 
      RowBox[{"ToJSON", "[", 
       RowBox[{"KeyDrop", "[", 
        RowBox[{
         RowBox[{"FromDFD", "[", "data", "]"}], ",", " ", "\"\<$schema\>\""}],
         "]"}], "]"}]}], ";", "\n", "\t\t", "\n", "\t\t", 
     RowBox[{"(*", " ", 
      RowBox[{"Compactify", " ", 
       RowBox[{"JSON", "."}]}], " ", "*)"}], "\n", "\t\t", 
     RowBox[{"str", " ", "=", " ", 
      RowBox[{"StringReplace", "[", 
       RowBox[{"str", ",", " ", 
        RowBox[{"\"\<{\\n  \\\"\>\"", " ", "->", " ", "\"\<{ \\\"\>\""}]}], 
       "]"}]}], ";", "\n", "\t\t", 
     RowBox[{"str", " ", "=", " ", 
      RowBox[{"StringReplace", "[", 
       RowBox[{"str", ",", " ", 
