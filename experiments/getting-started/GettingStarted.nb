       RowBox[{"input", "[", "]"}], "[", "11", "]"}], "[", "]"}], ",", " ", 
     "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "]"}], "[", "]"}], "[", 
      RowBox[{"11", "\"\<R\>\""}], "]"}], ",", " ", "\n", "\t", 
