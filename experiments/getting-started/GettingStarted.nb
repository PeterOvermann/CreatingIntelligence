Cell["\<\
Zero-padding, specified by a list [1, 0, ...]  is typically used to flush the \
delay line in embedded circuits that take multiple cycles to process an \
individual input. \
\>", "Text",ExpressionUUID->"47cb715c-ff12-4562-96ca-a1d937136b8b"],

Cell["\<\
With the following dataflow, inputs by default are delayed by one cycle. \
Zero-padding with one additional cycle removes the delay:\
\>", "Text",ExpressionUUID->"9852371e-57eb-4309-b9b1-f2251ae5f6d3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dataflow", "[", 
  RowBox[{
   RowBox[{"{", "\n", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"input", "[", "]"}], " ", "[", "11", "]"}], " ", "[", "]"}], ",",
      " ", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"delay", "[", "]"}], "[", "21", "]"}], "[", "11", "]"}], ",", 
     "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"delay", "[", "]"}], "[", "31", "]"}], "[", 
      RowBox[{"21", "\"\<?\>\""}], "]"}], ",", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "]"}], " ", "[", "]"}], " ", "[", "31", "]"}], ",",
      "\n", "\t", 
     RowBox[{"_", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "5"}], "}"}]}], ",", "\n", "\t", 
     RowBox[{"\"\<multiplex\>\"", " ", "->", " ", "\"\<10\>\""}]}], "\n", 
    "\t", "}"}], ",", " ", "275"}], "]"}]], "Code",
 CellLabel->
  "In[5850]:=",ExpressionUUID->"454ae649-0e34-41f5-a954-4085f609ee75"],

