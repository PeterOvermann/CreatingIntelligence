     "\n", "  \t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "]"}], "[", "]"}], "[", 
      RowBox[{"11", " ", "\"\<R\>\""}], "]"}], ",", " ", "\n", "  \t", 
     RowBox[{"11", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "5"}], "}"}]}]}], "\n", "  \t", "}"}], ",", 
   " ", "120"}], "]"}]], "Code",
 CellLabel->
  "In[128]:=",ExpressionUUID->"25eb11f6-dcb4-429e-b54b-250f5965b741"],

