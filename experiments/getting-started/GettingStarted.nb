Cell[CellGroupData[{

Cell["Circuit Visualization", "Section",ExpressionUUID->"345cf4c1-bdb2-45f4-8a83-3534b415b365"],

Cell["\<\
We can customize the rendering style of circuit components with display \
labels, different font sizes and colors, and background fill colors. The \
system uses a standard color palette with colors numbered from 0 to 15.\
\>", "Text",ExpressionUUID->"40fd65ad-b954-46bf-99ca-0e7ad27ec1c3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dataflow", "[", 
  RowBox[{
   RowBox[{"{", "\n", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"input", "[", 
        RowBox[{
         RowBox[{"\"\<label\>\"", "->", "\"\<A\>\""}], ",", " ", 
         RowBox[{"\"\<color\>\"", " ", "->", " ", "11"}], ",", " ", 
         RowBox[{"\"\<size\>\"", "->", " ", "20"}]}], "]"}], "[", "11", "]"}],
       "[", "]"}], ",", " ", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", 
        RowBox[{
         RowBox[{"\"\<label\>\"", "->", "\"\<B\>\""}], ",", " ", 
         RowBox[{"\"\<fill\>\"", "->", " ", "15"}], ",", " ", 
         RowBox[{"\"\<size\>\"", " ", "->", " ", "12"}]}], "]"}], "[", "]"}], 
      "[", "11", "]"}], ",", " ", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", 
        RowBox[{"\"\<fill\>\"", " ", "->", " ", "8"}], "]"}], "[", "]"}], "[",
       "11", "]"}], ",", " ", "\n", "\t", 
     RowBox[{"_", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "10"}], "}"}]}]}], "\n", "\t", "}"}], ",", 
   " ", "120"}], "]"}]], "Code",
 CellLabel->
  "In[2466]:=",ExpressionUUID->"5c3cf01b-b308-4af1-8fd5-ee61c902ef45"],

