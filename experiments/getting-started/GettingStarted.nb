Cell[CellGroupData[{

Cell["Temporal-associative memory", "Section",ExpressionUUID->"4c71dbc2-f4f2-4818-9e12-4dee5d30a5d8"],

Cell["\<\
Temporal-associative memory is a hybrid between auto-associative and \
hetero-associative architectures. It operates on a shared input/output layer, \
and associates its state to the next input, acting as a next-token predictor. \
The temporal integration mechanics is shared with the \
\[OpenCurlyDoubleQuote]delay\[CloseCurlyDoubleQuote] component.  \
\>", "Text",ExpressionUUID->"0eea4050-bac0-4c5c-87a5-3f4ec389a2f9"],

Cell["\<\
By default, the \[OpenCurlyDoubleQuote]temporal\[CloseCurlyDoubleQuote] \
component accumulates its state through repeated permutation, enabling to \
learn long token sequences on the fly.\
\>", "Text",ExpressionUUID->"0883f76b-4290-426b-9a7e-db6be2176fd7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dataflow", "[", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"input", "[", "codec", "]"}], " ", "[", "11", "]"}], " ", "[", 
      "]"}], ",", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"temporal", "[", 
        RowBox[{
         RowBox[{"\"\<capacity\>\"", "->", "3.0"}], ",", " ", 
         RowBox[{"\"\<decimate\>\"", " ", "->", " ", "0.8"}]}], "]"}], " ", "[",
        "21", "]"}], " ", "[", "11", "]"}], ",", " ", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "codec", "]"}], " ", "[", "]"}], " ", "[", "21",
       "]"}], ",", "\n", "\t", 
     RowBox[{"_", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "10"}], "}"}]}]}], "\n", "\t", "}"}], ",", 
   " ", "200"}], "]"}]], "Code",
 CellLabel->
  "In[1055]:=",ExpressionUUID->"7d8c65b6-96ad-4cd5-8a08-1334d40914f0"],

Cell[BoxData[
 FrameBox[
  TagBox[GridBox[{
     {
      StyleBox[
       TagBox["\<\"{ \\\"hyperparameters\\\": {\\\"default\\\": [1000, \
10]},\\n  \\\"dataflow\\\": [\\n\\t{\\\"component\\\": \\\"input\\\", \
\\\"plugin\\\": \\\"codec\\\", \\\"send\\\": [11]},\\n\\t{\\\"component\\\": \
\\\"temporal\\\", \\\"send\\\": [21], \\\"receive\\\": [11], \
\\\"capacity\\\": 3.0, \\\"decimate\\\": 0.8},\\n\\t{\\\"component\\\": \
\\\"output\\\", \\\"plugin\\\": \\\"codec\\\", \\\"receive\\\": [21]}\\n  \
