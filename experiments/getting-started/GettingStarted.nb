Cell[CellGroupData[{

Cell["Path merging with kWTA", "Subsubsection",ExpressionUUID->"facbe457-02f9-413e-805a-bdfce84233d6"],

Cell["\<\
Merging paths where at least one path is tagged with \
\[OpenCurlyDoubleQuote]kwta_absolute\[CloseCurlyDoubleQuote] (displayed as \
\[OpenCurlyDoubleQuote]k\[CloseCurlyDoubleQuote]) applies the kWTA algorithm, \
using the path\[CloseCurlyQuote]s population parameter as the ranking \
parameter. \
\>", "Text",ExpressionUUID->"0954146c-b7c5-490a-b6ab-f768a494c01a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dataflow", "[", 
