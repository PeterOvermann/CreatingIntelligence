 FrameBox[
  TagBox[GridBox[{
     {
      StyleBox[
       TagBox["\<\"{ \\\"hyperparameters\\\": {\\\"11\\\": [1000, 8], \
\\\"default\\\": [500, 5]},\\n  \\\"dataflow\\\": [\\n\\t{\\\"component\\\": \
\\\"input\\\", \\\"send\\\": [11]},\\n\\t{\\\"component\\\": \\\"input\\\", \
\\\"send\\\": [12]},\\n\\t{\\\"component\\\": \\\"associator\\\", \
\\\"send\\\": [101], \\\"receive\\\": [12, 11]},\\n\\t{\\\"component\\\": \
\\\"output\\\", \\\"receive\\\": [101]}\\n  ]}\"\>",
        Function[BoxForm`e$, 
