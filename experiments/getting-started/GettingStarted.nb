 FrameBox[
  OverlayBox[{
   TagBox[GridBox[{
      {
       StyleBox[
        TagBox[
         TagBox[GridBox[{
            {"\<\"input[] [11] []\"\>"},
            {"\<\"input[] [12] []\"\>"},
            {"\<\"associator[] [101] [12,11]\"\>"},
            {"\<\"output[] [] [101]\"\>"},
            {"\<\"11->{1000,8}\"\>"},
            {"\<\"_->{500,5}\"\>"}
           },
           GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
