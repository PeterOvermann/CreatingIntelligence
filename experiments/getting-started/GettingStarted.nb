Cell[CellGroupData[{

Cell["Data routing and merging", "Subsubsection",ExpressionUUID->"b80de31a-ae0c-453b-960c-ec2d5f6220e5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"table3", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\"\<X\>\"", ",", "\"\<\\\"veto\\\"\>\"", 
      ",", "\"\<clears all paths if any X path is non-empty\>\""}], "}"}], ",",
     " ", "\n", 
    RowBox[{"{", 
     RowBox[{"\"\<*\>\"", ",", " ", "\"\<\\\"mandatory\\\"\>\"", 
      ",", "\"\<clears all paths if any * path is empty\>\""}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\"\<!\>\"", ",", " ", "\"\<\\\"priority\\\"\>\"", 
      ",", "\"\<clears all non-! paths if any ! path is non-empty\>\""}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\"\<&\>\"", ",", " ", "\"\<\\\"dependency\\\"\>\"", ",", 
      " ", "\"\<clears & paths if any non-& path is empty (AND)\>\""}], "}"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\"\<|\>\"", ",", " ", "\"\<\\\"fallback\\\"\>\"", ",", 
      " ", "\"\<clears | paths if any non-| path is non-empty (NOR)\>\""}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\"\<=\>\"", ",", " ", "\"\<\\\"barrier\\\"\>\"", ",", 
      " ", "\"\<clears = paths if any = path is empty\>\""}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\"\<K\>\"", ",", " ", "\"\<\\\"kwta_excitatory\\\"\>\"", ",", 
      " ", "\"\<top-k excitatory (positive) signals\>\""}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\"\<k\>\"", ",", " ", "\"\<\\\"kwta_absolute\\\"\>\"", ",", 
      " ", "\"\<top-k signals (total saliency)\>\""}], "}"}]}], "}"}], 
  "]"}]], "Code",
 CellLabel->
  "In[349]:=",ExpressionUUID->"81fea832-ca37-47d0-9966-8df4a869aa8a"],

Cell[BoxData[
 TagBox[GridBox[{
    {Cell["X",ExpressionUUID->"5dbb9579-497e-4439-953f-49629f78be53"], Cell[
     "\"veto\"",ExpressionUUID->"b8e24cce-7d6c-4709-85e5-004325df9696"], Cell[
     "clears all paths if any X path is non-empty",ExpressionUUID->
      "f78b102e-5d61-4374-acb8-fb314928b8a9"]},
    {Cell["*",ExpressionUUID->"bd4ae46b-43b3-490d-8e8f-85c63f3c7d53"], Cell[
