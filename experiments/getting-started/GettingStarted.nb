      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], "}"}]}], ",", 
     RowBox[{"\<\"node_id\"\>", "\[Rule]", "2"}], ",", 
     RowBox[{"\<\"send_slots\"\>", "\[Rule]", 
      RowBox[{"{", "21", "}"}]}], ",", 
     RowBox[{"\<\"scale\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"1000", ",", "10"}], "}"}]}], ",", 
     RowBox[{"\<\"receive_blocks\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1000", ",", "10"}], "}"}], "}"}]}], ",", 
     RowBox[{"\<\"send_blocks\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1000", ",", "10"}], "}"}], "}"}]}]}], 
    "\[RightAssociation]"}]}],
  SequenceForm[
