         RowBox[{"\"\<label\>\"", "->", "\"\<B\>\""}], ",", " ", 
         RowBox[{"\"\<fill\>\"", "->", " ", "15"}], ",", " ", 
         RowBox[{"\"\<size\>\"", " ", "->", " ", "12"}]}], "]"}], "[", "]"}], 
      "[", "11", "]"}], ",", " ", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", 
        RowBox[{"\"\<fill\>\"", " ", "->", " ", "8"}], "]"}], "[", "]"}], "[",
       "11", "]"}], ",", " ", "\n", "\t", 
     RowBox[{"_", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "10"}], "}"}]}]}], "\n", "\t", "}"}], ",", 
   " ", "120"}], "]"}]], "Code",
