        GraphicsColor->RGBColor[
         0.1803921568627451, 0.20392156862745098`, 0.25098039215686274`],
        FontFamily->"JetBrains Mono",
        FontSize->11,
        FontColor->RGBColor[
         0.1803921568627451, 0.20392156862745098`, 0.25098039215686274`]], 
       StyleBox[
        GraphicsBox[
         NamespaceBox["NetworkGraphics",
          DynamicModuleBox[{Typeset`graph = HoldComplete[
            
            Graph[{2, 3, 1, 
             4}, {{{1, 2}, {3, 2}, {2, 4}}, Null, {"", "", ""}}, {
             BaseStyle -> {FontFamily -> "Inter Variable", 
