Cell["\<\
The source of each pathway is a numbered slot. Slot numbers can be choosen \
arbitrarily. Hyperparameters are assigned to slots. In the above example, a \
dimension N = 1000 and a set population P = 10 are specified as the default \
setting for all slots.

This setup simply echoes its input:\
\>", "Text",ExpressionUUID->"9a0f8562-2f15-4904-999d-5924785ac637"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"test", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5"}], "}"}], "]"}], "[", 
  
  RowBox[{"{", 
   RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5"}], "}"}], 
  "]"}]], "Code",
 CellLabel->
  "In[5169]:=",ExpressionUUID->"5245656a-10d0-46f0-a6c4-638194d0cbb8"],

