Cell[CellGroupData[{

Cell["Circuit Connections", "Section",ExpressionUUID->"959a6ecf-47ef-4108-975e-418b56994403"],

Cell["\<\
The data paths connecting circuit components can be flexibly configured to \
transport, transform, route and merge data. In the dataflow description, \
pathway options are given as tags wtihin the the components\[CloseCurlyQuote] \
\[OpenCurlyDoubleQuote]receive\[CloseCurlyDoubleQuote] property.
\
\>", "Text",ExpressionUUID->"bca56f70-d3f4-4a79-87ac-b280444af2dc"],

Cell["\<\
In the following example, the pathway is tagged with \
\[OpenCurlyDoubleQuote]rate_limit\[CloseCurlyDoubleQuote]:\
\>", "Text",ExpressionUUID->"eefb1d8a-dc61-4605-9820-6a102184e3dd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dataflow", "[", 
  RowBox[{
   RowBox[{"{", "\n", "  \t", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"input", "[", "]"}], "[", "11", "]"}], "[", "]"}], ",", " ", 
     "\n", "  \t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "]"}], "[", "]"}], "[", 
      RowBox[{"11", " ", "\"\<R\>\""}], "]"}], ",", " ", "\n", "  \t", 
     RowBox[{"11", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "5"}], "}"}]}]}], "\n", "  \t", "}"}], ",", 
   " ", "120"}], "]"}]], "Code",
 CellLabel->
  "In[5177]:=",ExpressionUUID->"25eb11f6-dcb4-429e-b54b-250f5965b741"],

