Cell[CellGroupData[{

Cell["Data routing and merging", "Subsubsection",ExpressionUUID->"b80de31a-ae0c-453b-960c-ec2d5f6220e5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"table3", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\"\<X\>\"", ",", "\"\<\\\"veto\\\"\>\"", 
      ",", "\"\<clears all paths if any X path is non-empty\>\""}], "}"}], ",",
     " ", "\n", 
    RowBox[{"{", 
     RowBox[{"\"\<*\>\"", ",", " ", "\"\<\\\"mandatory\\\"\>\"", 
      ",", "\"\<clears all paths if any * path is empty\>\""}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\"\<!\>\"", ",", " ", "\"\<\\\"priority\\\"\>\"", 
      ",", "\"\<clears all non-! paths if any ! path is non-empty\>\""}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\"\<&\>\"", ",", " ", "\"\<\\\"dependency\\\"\>\"", ",", 
      " ", "\"\<clears & paths if any non-& path is empty (AND)\>\""}], "}"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\"\<|\>\"", ",", " ", "\"\<\\\"fallback\\\"\>\"", ",", 
      " ", "\"\<clears | paths if any non-| path is non-empty (NOR)\>\""}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\"\<=\>\"", ",", " ", "\"\<\\\"barrier\\\"\>\"", ",", 
      " ", "\"\<clears = paths if any = path is empty\>\""}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\"\<K\>\"", ",", " ", "\"\<\\\"kwta_excitatory\\\"\>\"", ",", 
      " ", "\"\<top-k excitatory (positive) signals\>\""}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\"\<k\>\"", ",", " ", "\"\<\\\"kwta_absolute\\\"\>\"", ",", 
      " ", "\"\<top-k signals (total saliency)\>\""}], "}"}]}], "}"}], 
  "]"}]], "Code",
 CellLabel->"In[33]:=",ExpressionUUID->"81fea832-ca37-47d0-9966-8df4a869aa8a"],

Cell[BoxData[
 TagBox[GridBox[{
    {Cell["X",ExpressionUUID->"4d36a6bc-b283-43dd-886b-5b736dd6f391"], Cell[
     "\"veto\"",ExpressionUUID->"0f64007c-3bc8-4cfe-bf47-319615eec628"], Cell[
     "clears all paths if any X path is non-empty",ExpressionUUID->
      "1f5ee3c8-5a7b-4af3-b0ac-acda5cf89a81"]},
