Cell[CellGroupData[{

Cell["Data routing and merging", "Subsubsection",ExpressionUUID->"b80de31a-ae0c-453b-960c-ec2d5f6220e5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"table3", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\"\<X\>\"", ",", "\"\<\\\"veto\\\"\>\"", 
      ",", "\"\<clears all paths if any X path is non-empty\>\""}], "}"}], ",",
     " ", "\n", 
    RowBox[{"{", 
     RowBox[{"\"\<*\>\"", ",", " ", "\"\<\\\"mandatory\\\"\>\"", 
      ",", "\"\<clears all paths if any * path is empty\>\""}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\"\<!\>\"", ",", " ", "\"\<\\\"priority\\\"\>\"", 
      ",", "\"\<clears all non-! paths if any ! path is non-empty\>\""}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\"\<&\>\"", ",", " ", "\"\<\\\"dependency\\\"\>\"", ",", 
      " ", "\"\<clears & paths if any non-& path is empty (AND)\>\""}], "}"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\"\<|\>\"", ",", " ", "\"\<\\\"fallback\\\"\>\"", ",", 
      " ", "\"\<clears | paths if any non-| path is non-empty (NOR)\>\""}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\"\<=\>\"", ",", " ", "\"\<\\\"barrier\\\"\>\"", ",", 
      " ", "\"\<clears = paths if any = path is empty\>\""}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\"\<K\>\"", ",", " ", "\"\<\\\"kwta_excitatory\\\"\>\"", ",", 
      " ", "\"\<top-k excitatory (positive) signals\>\""}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\"\<k\>\"", ",", " ", "\"\<\\\"kwta_absolute\\\"\>\"", ",", 
      " ", "\"\<top-k signals (total saliency)\>\""}], "}"}]}], "}"}], 
  "]"}]], "Code",
 CellLabel->
  "In[4542]:=",ExpressionUUID->"81fea832-ca37-47d0-9966-8df4a869aa8a"],

Cell[BoxData[
 TagBox[GridBox[{
    {Cell["X",ExpressionUUID->"22609642-bf5c-489e-8fea-4f750cb098ff"], Cell[
