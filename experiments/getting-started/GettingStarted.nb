    {Cell["|",ExpressionUUID->"9b6b2610-81ea-4434-9f0d-92d73be5e248"], Cell[
     "\"fallback\"",ExpressionUUID->"588ffd7d-fa6b-4b4a-9b5c-fd22efb0c721"], 
     Cell["clears | paths if any non-| path is non-empty (NOR)",
