           RowBox[{"TEST", "[", "\"\<cases\>\"", "]"}], " ", "=", " ", 
           "CASES"}], ";", "\n", "\t\t", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"TESTSUITE", ",", " ", "TEST"}], "]"}], ";"}]}], "\n", 
        "\t\t", "]"}], ";", "\n", "\t\t", "\n", "\t", 
       RowBox[{"CASES", " ", "=", " ", 
        RowBox[{"{", "}"}]}], ";"}]}], "\n", "\t", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"dataflow", "[", 
   RowBox[{"data_List", ",", " ", "size_Integer"}], "]"}], " ", ":=", " ", 
  "\n", "    ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "dfdstr", ",", " ", "dfdexpr", ",", " ", "jsonstr", ",", " ", "circuit", 
      ",", " ", "exprimport", ",", " ", "\n", "    ", "str", ",", " ", 
      "graph", ",", " ", "format", ",", " ", "flow", ",", " ", 
      RowBox[{"width", " ", "=", " ", "600"}]}], "}"}], ",", "\n", " ", "\n", 
    "        ", "\n", "\t\t", 
    RowBox[{"WRAP", ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "the", " ", "previous", " ", "circuit", " ", "and", " ", "test", " ", 
       RowBox[{"cases", "."}]}], " ", "*)"}], "\t", "\n", 
     "                      ", "\n", "        ", 
     RowBox[{"(*", " ", 
      RowBox[{"Verify", " ", "DFD", " ", 
       RowBox[{"Export", "/", "Import"}], " ", 
       RowBox[{"roundtrip", "."}]}], " ", "*)"}], "\n", "\n", "        ", 
     RowBox[{"dfdstr", " ", "=", " ", 
      RowBox[{"ExportString", "[", " ", 
       RowBox[{"data", ",", " ", "\"\<Package\>\""}], "]"}]}], ";", 
     "                            ", "\n", "        ", 
     RowBox[{"circuit", " ", "=", " ", 
      RowBox[{"ImportString", "[", 
       RowBox[{"dfdstr", ",", " ", "\"\<CircuitDFD\>\""}], "]"}]}], ";", " ", 
     "\n", "        ", 
     RowBox[{"dfdexpr", " ", "=", " ", 
      RowBox[{"ImportString", "[", " ", 
       RowBox[{
        RowBox[{"ExportString", "[", 
         RowBox[{"circuit", ",", " ", "\"\<CircuitDFD\>\""}], "]"}], ",", 
        " ", "\"\<CircuitDFD\>\""}], "]"}]}], ";", "\n", "  ", "\n", 
     "  \t   ", 
     RowBox[{"If", "[", " ", 
      RowBox[{
       RowBox[{"circuit", " ", "=!=", " ", "dfdexpr"}], ",", " ", "\n", 
       "\t\t\t", 
       RowBox[{
        RowBox[{"++", " ", "ERRORCOUNT"}], ";", "\n", "\t\t\t", 
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"Circuit", "::", "regress"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"circuit", ",", " ", "dfdexpr"}], "}"}]}], "]"}], ";"}]}], 
      "\n", "\t\t\t", "]"}], ";", "\n", "             ", "\n", "        ", 
     RowBox[{"(*", " ", 
      RowBox[{"Verify", " ", "JSON", " ", 
       RowBox[{"Export", "/", "Import"}], " ", 
       RowBox[{"roundtrip", "."}]}], " ", "*)"}], "\n", "\n", "        ", 
     RowBox[{"jsonstr", " ", "=", " ", 
      RowBox[{"ExportString", "[", 
       RowBox[{"circuit", ",", " ", "\"\<Circuit\>\""}], "]"}]}], ";", "   ", 
     "\n", "        ", 
     RowBox[{"exprimport", " ", "=", " ", 
      RowBox[{"ImportString", "[", 
