      "\n", "\t\t\t", "]"}], ";", "\n", "\t\t\t", "\n", "\t\t", 
     RowBox[{"TEST", " ", "=", " ", 
      RowBox[{"If", "[", 
       RowBox[{"IGNORE", ",", " ", "Nothing", ",", "\n", "\t\t\t", 
        RowBox[{"<|", " ", 
         RowBox[{"\"\<circuit\>\"", " ", "->", " ", 
          RowBox[{"KeyDrop", "[", 
           RowBox[{
            RowBox[{"ImportString", "[", 
             RowBox[{"jsonstr", ",", " ", "\"\<RawJSON\>\""}], "]"}], ",", 
            " ", "\"\<$schema\>\""}], "]"}]}], " ", "|>"}]}], "]"}]}], ";", 
     "\n", "\n", "\t\t", 
     RowBox[{"(*", " ", 
      RowBox[{"Clear", " ", "previous", " ", 
       RowBox[{"circuit", "."}]}], " ", "*)"}], "\n", "\t\t", 
     RowBox[{"CIRCUIT", "[", "\"\<clear\>\"", "]"}], ";", "\n", "\t\t", "\n", 
     "\t\t", 
     RowBox[{"(*", " ", 
      RowBox[{"Instantiate", " ", "current", " ", 
       RowBox[{"circuit", "."}]}], " ", "*)"}], "\n", "\t\t", 
     RowBox[{"CIRCUIT", " ", "=", " ", 
      RowBox[{"Circuit", "[", "circuit", "]"}]}], ";", "\n", "\t\t", 
     RowBox[{"CIRCUITCOUNT", "++"}], ";", "\n", "        ", "\n", "\t\t", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"Magnify", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"CIRCUIT", "[", "\"\<schematics\>\"", "]"}], "[", 
