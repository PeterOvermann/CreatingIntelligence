            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Spacer", "[", "18", "]"}], ",", " ", "graph"}], "}"}],
              "]"}], "}"}]}], "}"}], ",", "\n", "\t\t\t\t", 
