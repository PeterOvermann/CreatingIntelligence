     "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "]"}], "[", "]"}], "[", 
      RowBox[{"11", "\"\<k+\>\""}], "]"}], ",", "\n", "\t", 
     RowBox[{"_", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "5"}], "}"}]}]}], " ", 
    RowBox[{"(*", " ", 
     RowBox[{"k", " ", "=", " ", "5"}], " ", "*)"}], "\n", "\t", "}"}], ",", 
   " ", "120"}], "]"}]], "Code",
