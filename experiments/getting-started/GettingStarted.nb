      RowBox[{
       RowBox[{"delay", "[", "]"}], "[", "21", "]"}], "[", "11", "]"}], ",", 
     "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "]"}], "[", "]"}], "[", 
      RowBox[{"{", 
       RowBox[{"11", ",", " ", "21"}], "}"}], "]"}], ",", "\n", "\t", 
     RowBox[{"_", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "5"}], "}"}]}]}], "\n", "\t", "}"}], ",", 
   " ", "200"}], "]"}]], "Code",
