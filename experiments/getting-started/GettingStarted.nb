     RowBox[{"_", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "5"}], "}"}]}], ",", "\n", "\t", 
     RowBox[{"\"\<multiplex\>\"", " ", "->", " ", "\"\<111\>\""}]}], "\n", 
    "\t", "}"}], ",", " ", "120"}], "]"}]], "Code",
 CellLabel->
  "In[2557]:=",ExpressionUUID->"e3ddacc9-33d6-4188-ace1-b91442ac3f82"],

