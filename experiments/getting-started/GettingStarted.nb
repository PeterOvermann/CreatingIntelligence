In[4777]:=",ExpressionUUID->"7d2fb6b9-b912-4ccf-9726-f9a205bee9df"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"plugin = \"\>", "\[InvisibleSpace]", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"updaterule\"\>", "\[Rule]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Complement", "[", 
         RowBox[{"#1", ",", "#2"}], "]"}], "&"}], ")"}]}], ",", 
     RowBox[{"\<\"label\"\>", "\[Rule]", "\<\"\[EmptyDownTriangle]\"\>"}], ",", 
     RowBox[{"\<\"size\"\>", "\[Rule]", "20"}]}], "\[RightAssociation]"}]}],
  SequenceForm[
  "plugin = ", <|
