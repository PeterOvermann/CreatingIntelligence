     "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"delay", "[", "]"}], "[", "21", "]"}], "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"11", "\"\<!\>\""}], ",", " ", "22"}], "}"}], "]"}], ",", 
     "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"delay", "[", "]"}], "[", "22", "]"}], "[", "21", "]"}], ",", 
     "\n", "\t", 
