        "\t\t", "]"}], ";", "\n", "\t\t", "\n", "\t", 
       RowBox[{"CASES", " ", "=", " ", 
        RowBox[{"{", "}"}]}], ";"}]}], "\n", "\t", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"dataflow", "[", 
   RowBox[{"data_List", ",", " ", "size_Integer"}], "]"}], " ", ":=", " ", 
  "\n", "    ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "dfdstr", ",", " ", "dfdexpr", ",", " ", "jsonstr", ",", " ", "circuit", 
      ",", " ", "exprimport", ",", " ", "\n", "    ", "str", ",", " ", 
      "graph", ",", " ", "format", ",", " ", "flow", ",", " ", 
      RowBox[{"width", " ", "=", " ", "600"}]}], "}"}], ",", "\n", " ", "\n", 
    "        ", "\n", "\t\t", 
    RowBox[{"WRAP", ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "the", " ", "previous", " ", "circuit", " ", "and", " ", "test", " ", 
