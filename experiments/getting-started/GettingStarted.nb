        "\t\t", "]"}], ";", "\n", "\t\t", "\n", "\t", 
       RowBox[{"CASES", " ", "=", " ", 
        RowBox[{"{", "}"}]}], ";"}]}], "\n", "\t", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"dataflow", "[", 
