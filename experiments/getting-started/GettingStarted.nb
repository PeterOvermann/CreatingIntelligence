Cell[CellGroupData[{

Cell["Hyper-Associative Memory", "Section",ExpressionUUID->"39526513-a8cf-43f3-b724-9813ca67c2d9"],

Cell["\<\
This sets up an auto-associative memory using the \
\[OpenCurlyDoubleQuote]complement\[CloseCurlyDoubleQuote] update rule. The \
system learns new information if it lies in the specified population range:\
\>", "Text",ExpressionUUID->"c4f6195d-8e16-4351-aa10-578286913b34"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dataflow", "[", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"input", "[", "codec", "]"}], " ", "[", "11", "]"}], " ", "[", 
      "]"}], ",", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"auto", "[", 
        RowBox[{"complement", ",", 
         RowBox[{"\"\<learn\>\"", "->", 
          RowBox[{"{", 
           RowBox[{"1.0", ",", "10.0"}], "}"}]}]}], "]"}], " ", "[", "21", 
       "]"}], " ", "[", "11", "]"}], ",", " ", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "codec", "]"}], " ", "[", "]"}], " ", "[", "21",
       "]"}], ",", "\n", "\t", 
     RowBox[{"_", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "10"}], "}"}]}]}], "\n", "\t", "}"}], ",", 
   " ", "200"}], "]"}]], "Code",
 CellLabel->
  "In[5422]:=",ExpressionUUID->"9de1a904-bafa-434f-a7d3-269ccf7e1e83"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"config = \"\>", "\[InvisibleSpace]", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"component\"\>", "\[Rule]", "auto"}], ",", 
     RowBox[{"\<\"plugin\"\>", "\[Rule]", "complement"}], ",", 
     RowBox[{"\<\"send\"\>", "\[Rule]", 
      RowBox[{"{", "21", "}"}]}], ",", 
     RowBox[{"\<\"receive\"\>", "\[Rule]", 
      RowBox[{"{", "11", "}"}]}], ",", 
     RowBox[{"\<\"learn\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"1.`", ",", "10.`"}], "}"}]}], ",", 
     RowBox[{"\<\"receive_paths\"\>", "\[Rule]", 
      RowBox[{"{", "1", "}"}]}], ",", 
     RowBox[{"\<\"node_id\"\>", "\[Rule]", "2"}], ",", 
     RowBox[{"\<\"send_slots\"\>", "\[Rule]", 
      RowBox[{"{", "21", "}"}]}], ",", 
     RowBox[{"\<\"scale\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"1000", ",", "10"}], "}"}]}], ",", 
     RowBox[{"\<\"receive_blocks\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1000", ",", "10"}], "}"}], "}"}]}], ",", 
     RowBox[{"\<\"send_blocks\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1000", ",", "10"}], "}"}], "}"}]}]}], 
    "\[RightAssociation]"}]}],
  SequenceForm[
  "config = ", <|
   "component" -> $CellContext`auto, "plugin" -> $CellContext`complement, 
    "send" -> {21}, "receive" -> {11}, "learn" -> {1., 10.}, 
    "receive_paths" -> {1}, "node_id" -> 2, "send_slots" -> {21}, 
    "scale" -> {1000, 10}, "receive_blocks" -> {{1000, 10}}, 
    "send_blocks" -> {{1000, 10}}|>],
  Editable->False]], "Print",
 CellLabel->
  "During evaluation of \
In[5422]:=",ExpressionUUID->"08e5286c-6209-4cd8-a1ff-0e1e0a7bb4ea"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"plugin = \"\>", "\[InvisibleSpace]", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"updaterule\"\>", "\[Rule]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Complement", "[", 
         RowBox[{"#1", ",", "#2"}], "]"}], "&"}], ")"}]}], ",", 
     RowBox[{"\<\"label\"\>", "\[Rule]", "\<\"\[EmptyDownTriangle]\"\>"}], ",", 
     RowBox[{"\<\"size\"\>", "\[Rule]", "20"}]}], "\[RightAssociation]"}]}],
  SequenceForm[
  "plugin = ", <|
   "updaterule" -> (Complement[#, #2]& ), "label" -> "\[EmptyDownTriangle]", 
    "size" -> 20|>],
  Editable->False]], "Print",
 CellLabel->
