     Cell["clears all paths if any * path is empty",ExpressionUUID->
      "c5ed6296-aa29-452f-af39-6e9e74038190"]},
    {Cell["!",ExpressionUUID->"322307e2-618f-49b7-952b-312abb1b2ff9"], Cell[
