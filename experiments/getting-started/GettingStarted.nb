     RowBox[{
      RowBox[{
       RowBox[{"input", "[", "]"}], " ", "[", "11", "]"}], " ", "[", "]"}], ",",
      " ", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{
