      RowBox[{
       RowBox[{"{", 
        RowBox[{"Center", ",", " ", "Center", ",", " ", "Center"}], "}"}], ",",
        " ", "Center"}], "}"}]}]}], "\n", "]"}]}]], "Code",
 CellLabel->
  "In[5956]:=",ExpressionUUID->"6ea3ac29-57d8-4af2-a2d6-c4eb36271750"],

