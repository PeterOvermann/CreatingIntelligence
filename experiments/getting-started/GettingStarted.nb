     "  \t   ", 
     RowBox[{"If", "[", " ", 
      RowBox[{
       RowBox[{"circuit", " ", "=!=", " ", "dfdexpr"}], ",", " ", "\n", 
       "\t\t\t", 
       RowBox[{
        RowBox[{"++", " ", "ERRORCOUNT"}], ";", "\n", "\t\t\t", 
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"Circuit", "::", "regress"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"circuit", ",", " ", "dfdexpr"}], "}"}]}], "]"}], ";"}]}], 
      "\n", "\t\t\t", "]"}], ";", "\n", "             ", "\n", "        ", 
     RowBox[{"(*", " ", 
      RowBox[{"Verify", " ", "JSON", " ", 
       RowBox[{"Export", "/", "Import"}], " ", 
       RowBox[{"roundtrip", "."}]}], " ", "*)"}], "\n", "\n", "        ", 
     RowBox[{"jsonstr", " ", "=", " ", 
      RowBox[{"ExportString", "[", 
       RowBox[{"circuit", ",", " ", "\"\<Circuit\>\""}], "]"}]}], ";", "   ", 
     "\n", "        ", 
     RowBox[{"exprimport", " ", "=", " ", 
      RowBox[{"ImportString", "[", 
