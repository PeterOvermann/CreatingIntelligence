Cell[BoxData[{
 RowBox[{
  RowBox[{"ERRORCOUNT", " ", "=", " ", 
   RowBox[{"TESTCOUNT", " ", "=", " ", 
    RowBox[{"CIRCUITCOUNT", " ", "=", " ", "0"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "test", "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"test", "[", "x___", "]"}], "[", "pattern___", "]"}], " ", ":=", 
   " ", 
   RowBox[{"Module", "[", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"str", ",", " ", 
       RowBox[{"width", " ", "=", " ", "600"}], ",", " ", "tostring", ",", 
       " ", "result"}], "}"}], ",", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"tostring", "[", "s___", "]"}], " ", ":=", " ", 
       RowBox[{"StringRiffle", "[", " ", 
        RowBox[{
         RowBox[{"ToString", " ", "/@", " ", 
          RowBox[{"{", "s", "}"}]}], ",", " ", "\"\<, \>\""}], "]"}]}], ";", 
      "\n", "\t", "\n", "\t", 
      RowBox[{"(*", " ", 
       RowBox[{"Collect", " ", "test", " ", 
        RowBox[{"cases", "."}]}], " ", "*)"}], "\n", "\t", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"CASES", ",", " ", 
        RowBox[{
         RowBox[{"<|", " ", 
          RowBox[{
           RowBox[{"\"\<input\>\"", " ", "->", " ", 
            RowBox[{"{", "x", "}"}]}], ",", " ", 
           RowBox[{"\"\<output\>\"", " ", "->", " ", 
            RowBox[{"{", "pattern", "}"}]}]}], " ", "|>"}], " ", "/.", " ", 
         "\n", "\t\t", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Verbatim", "[", "_", "]"}], " ", "->", 
            " ", "\"\<_\>\""}], ",", " ", 
           RowBox[{
            RowBox[{"Verbatim", "[", "__", "]"}], " ", "->", 
            " ", "\"\<__\>\""}]}], "}"}]}]}], "]"}], ";", "\n", "\t", "\n", 
      "\t", 
      RowBox[{"result", " ", "=", " ", 
       RowBox[{
        RowBox[{"CIRCUIT", "[", "\"\<function\>\"", "]"}], "[", "x", "]"}]}], 
      ";", "\n", "\t", 
      RowBox[{"str", " ", "=", " ", 
       RowBox[{"\"\<> \>\"", " ", "<>", " ", 
        RowBox[{"tostring", "[", "x", "]"}], " ", "<>", " ", "\"\<\\n\>\"", 
        " ", "<>", " ", 
        RowBox[{"tostring", "[", "result", "]"}]}]}], ";", 
      "\[IndentingNewLine]", "\n", "\t", 
      RowBox[{"TESTCOUNT", "++"}], ";", "\n", "\t", "\n", "\t", 
      RowBox[{"If", "[", " ", 
       RowBox[{
        RowBox[{"!", " ", 
         RowBox[{"MatchQ", "[", " ", 
          RowBox[{
           RowBox[{"{", "result", "}"}], ",", " ", 
           RowBox[{"{", "pattern", "}"}]}], "]"}]}], ",", " ", "\n", "\t\t", 
        RowBox[{
         RowBox[{"++", " ", "ERRORCOUNT"}], ";", "\n", "\t\t", 
         RowBox[{"Message", "[", 
          RowBox[{
           RowBox[{"Circuit", "::", "regress"}], ",", " ", 
           RowBox[{"{", "pattern", "}"}]}], "]"}], ";"}]}], "\n", "\t\t", 
       "]"}], ";", "\n", "\n", "\t", 
      RowBox[{"Column", "[", " ", 
       RowBox[{"{", "\[IndentingNewLine]", "\t\t", 
        RowBox[{"Framed", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"str", ",", " ", 
            RowBox[{"FontFamily", " ", "->", " ", "codefontfamily"}], ",", 
            " ", 
            RowBox[{"Circuit`color", "[", "0", "]"}], ",", "\n", "\t\t", 
            RowBox[{"FontSize", " ", "->", " ", "codefontsize"}]}], "]"}], ",",
           " ", 
          RowBox[{"ImageSize", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"width", ",", " ", "Automatic"}], "}"}]}], ",", "\n", 
          "\t\t", 
          RowBox[{"Background", " ", "->", " ", 
           RowBox[{"Circuit`color", "[", "6", "]"}]}], ",", " ", 
          RowBox[{"FrameStyle", " ", "->", " ", "None"}], ",", " ", 
          RowBox[{"FrameMargins", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"20", ",", "0"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"5", ",", "5"}], "}"}]}], "}"}]}]}], "]"}], "}"}], 
       "]"}]}]}], "\[IndentingNewLine]", "\t", "]"}]}], ";"}]}], "Code",
