   RowBox[{"{", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"input", "[", "]"}], " ", "[", "11", "]"}], " ", "[", "]"}], ",",
      " ", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"auto", "[", 
        RowBox[{"\"\<learn\>\"", "->", " ", 
         RowBox[{"{", 
          RowBox[{"1.0", ",", " ", "1.5"}], "}"}]}], "]"}], " ", "[", "21", 
       "]"}], " ", "[", "11", "]"}], ",", " ", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "]"}], " ", "[", "]"}], " ", "[", "21", "]"}], ",",
      "\n", "\t", 
     RowBox[{"_", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "10"}], "}"}]}]}], "\n", "\t", "}"}], ",", 
