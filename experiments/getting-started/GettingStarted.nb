Cell[CellGroupData[{

Cell["Circuit Visualization", "Section",ExpressionUUID->"345cf4c1-bdb2-45f4-8a83-3534b415b365"],

Cell["\<\
We can customize the rendering style of circuit components with display \
labels, different font sizes and colors, and background fill colors. The \
system uses a standard color palette with colors numbered from 0 to 15.\
\>", "Text",ExpressionUUID->"40fd65ad-b954-46bf-99ca-0e7ad27ec1c3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dataflow", "[", 
  RowBox[{
   RowBox[{"{", "\n", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"input", "[", 
        RowBox[{
         RowBox[{"\"\<label\>\"", "->", "\"\<A\>\""}], ",", " ", 
         RowBox[{"\"\<color\>\"", " ", "->", " ", "11"}], ",", " ", 
         RowBox[{"\"\<size\>\"", "->", " ", "20"}]}], "]"}], "[", "11", "]"}],
       "[", "]"}], ",", " ", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", 
        RowBox[{
         RowBox[{"\"\<label\>\"", "->", "\"\<B\>\""}], ",", " ", 
         RowBox[{"\"\<fill\>\"", "->", " ", "15"}], ",", " ", 
         RowBox[{"\"\<size\>\"", " ", "->", " ", "12"}]}], "]"}], "[", "]"}], 
      "[", "11", "]"}], ",", " ", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", 
        RowBox[{"\"\<fill\>\"", " ", "->", " ", "8"}], "]"}], "[", "]"}], "[",
       "11", "]"}], ",", " ", "\n", "\t", 
     RowBox[{"_", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "10"}], "}"}]}]}], "\n", "\t", "}"}], ",", 
   " ", "120"}], "]"}]], "Code",
 CellLabel->"In[34]:=",ExpressionUUID->"5c3cf01b-b308-4af1-8fd5-ee61c902ef45"],

Cell[BoxData[
 FrameBox[
  TagBox[GridBox[{
     {
      StyleBox[
       TagBox["\<\"{ \\\"hyperparameters\\\": {\\\"default\\\": [1000, \
10]},\\n  \\\"dataflow\\\": [\\n\\t{\\\"component\\\": \\\"input\\\", \
\\\"send\\\": [11], \\\"label\\\": \\\"A\\\", \\\"color\\\": 11, \
\\\"size\\\": 20},\\n\\t{\\\"component\\\": \\\"output\\\", \\\"receive\\\": \
[11], \\\"label\\\": \\\"B\\\", \\\"fill\\\": 15, \\\"size\\\": 12},\\n\\t{\\\
\"component\\\": \\\"output\\\", \\\"receive\\\": [11], \\\"fill\\\": 8}\\n  \
]}\"\>",
        Function[BoxForm`e$, 
         TableForm[BoxForm`e$, TableSpacing -> {2, 1}]]],
       StripOnInput->False,
       LineColor->GrayLevel[0],
       FrontFaceColor->GrayLevel[0],
       BackFaceColor->GrayLevel[0],
       GraphicsColor->GrayLevel[0],
       FontFamily->"JetBrains Mono",
       FontSize->10,
       FontColor->GrayLevel[0]]},
     {
      TemplateBox[{10, 5},
       "Spacer2"]},
     {
      TemplateBox[{
        TemplateBox[{18}, "Spacer1"], 
        StyleBox[
         GraphicsBox[
          NamespaceBox["NetworkGraphics", 
           DynamicModuleBox[{Typeset`graph = HoldComplete[
               
               Graph[{1, 2, 3}, {{{1, 2}, {1, 3}}, Null, {"", ""}}, {
                BaseStyle -> {FontFamily -> "Inter Variable", 
                   Opacity[1]}, 
                 EdgeLabels -> {
                  DirectedEdge[1, 2, ""] -> None, DirectedEdge[1, 3, ""] -> 
                   None}, EdgeStyle -> {DirectedEdge[1, 2, ""] -> Directive[
                    RGBColor[
                    0.1803921568627451, 0.20392156862745098`, 
                    0.25098039215686274`], 
                    Opacity[1], 
                    AbsoluteThickness[0.5]], DirectedEdge[1, 3, ""] -> 
                   Directive[
                    RGBColor[
                    0.1803921568627451, 0.20392156862745098`, 
                    0.25098039215686274`], 
                    Opacity[1], 
                    AbsoluteThickness[0.5]]}, 
                 GraphLayout -> {
                  "LayeredDigraphEmbedding", "Orientation" -> Left}, 
                 ImageSize -> 120, PlotTheme -> "Classic", 
                 VertexLabels -> {2 -> Placed[
                    Style["B", 
                    RGBColor[
                    0.1803921568627451, 0.20392156862745098`, 
                    0.25098039215686274`], 12, Bold], Center], 1 -> Placed[
                    Style["A", 
                    RGBColor[
                    0.7490196078431373, 0.3803921568627451, 
                    0.41568627450980394`], 20, Bold], Center], 3 -> Placed[
                    Style["", 
                    RGBColor[
                    0.1803921568627451, 0.20392156862745098`, 
                    0.25098039215686274`], 10, Bold], Center]}, 
                 VertexShapeFunction -> {
                  3 -> "Circle", 1 -> "Circle", 2 -> "Circle"}, 
                 VertexSize -> {0.4}, VertexStyle -> {3 -> Directive[
                    RGBColor[
                    0.5333333333333333, 0.7529411764705882, 
                    0.8156862745098039], 
                    EdgeForm[
                    Directive[
