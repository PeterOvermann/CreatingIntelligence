Cell[CellGroupData[{

Cell["Hetero-associative memory", "Section",ExpressionUUID->"07b532b8-3551-445b-ae77-9ca9a4c9ba6f"],

Cell["\<\
Here is a basic hetero-associative memory circuit, taking two inputs and \
generating one output:\
\>", "Text",ExpressionUUID->"1cec135a-d6e5-40ed-a299-ee61a35bd6cd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dataflow", "[", 
  RowBox[{
   RowBox[{"{", " ", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"input", "[", "]"}], " ", "[", "11", "]"}], " ", "[", "]"}], ",",
      " ", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"input", "[", "]"}], " ", "[", "12", "]"}], " ", "[", "]"}], ",",
      " ", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"associator", "[", "]"}], "[", "101", "]"}], "[", 
      RowBox[{"12", ",", " ", "11"}], "]"}], ",", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "]"}], " ", "[", "]"}], " ", "[", "101", "]"}], 
     ",", "\n", "\t", 
     RowBox[{"11", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "8"}], "}"}]}], ",", "\n", "\t", 
     RowBox[{"_", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"500", ",", " ", "5"}], "}"}]}]}], "\n", "\t", "}"}], ",", " ",
    "240"}], "  ", "]"}]], "Code",
 CellLabel->
  "In[2716]:=",ExpressionUUID->"1612cfb9-3bef-4fd2-805a-9a77455e07dd"],

Cell[BoxData[
 FrameBox[
  TagBox[GridBox[{
     {
      StyleBox[
       TagBox["\<\"{ \\\"hyperparameters\\\": {\\\"11\\\": [1000, 8], \
\\\"default\\\": [500, 5]},\\n  \\\"dataflow\\\": [\\n\\t{\\\"component\\\": \
\\\"input\\\", \\\"send\\\": [11]},\\n\\t{\\\"component\\\": \\\"input\\\", \
\\\"send\\\": [12]},\\n\\t{\\\"component\\\": \\\"associator\\\", \
\\\"send\\\": [101], \\\"receive\\\": [12, 11]},\\n\\t{\\\"component\\\": \
\\\"output\\\", \\\"receive\\\": [101]}\\n  ]}\"\>",
        Function[BoxForm`e$, 
         TableForm[BoxForm`e$, TableSpacing -> {2, 1}]]],
       StripOnInput->False,
       LineColor->GrayLevel[0],
       FrontFaceColor->GrayLevel[0],
       BackFaceColor->GrayLevel[0],
       GraphicsColor->GrayLevel[0],
       FontFamily->"JetBrains Mono",
       FontSize->10,
       FontColor->GrayLevel[0]]},
     {
      TemplateBox[{10, 5},
       "Spacer2"]},
     {
      TemplateBox[{
        TemplateBox[{18}, "Spacer1"], 
        StyleBox[
         GraphicsBox[
          NamespaceBox["NetworkGraphics", 
           DynamicModuleBox[{Typeset`graph = HoldComplete[
               
               Graph[{2, 3, 1, 
                4}, {{{1, 2}, {3, 2}, {2, 4}}, Null, {"", "", ""}}, {
                BaseStyle -> {FontFamily -> "Inter Variable", 
                   Opacity[1]}, 
                 EdgeLabels -> {
                  DirectedEdge[3, 4, ""] -> None, DirectedEdge[1, 3, ""] -> 
                   None, DirectedEdge[2, 3, ""] -> None}, 
                 EdgeStyle -> {DirectedEdge[2, 3, ""] -> Directive[
                    RGBColor[
                    0.1803921568627451, 0.20392156862745098`, 
                    0.25098039215686274`], 
                    Opacity[1], 
                    AbsoluteThickness[0.5]], DirectedEdge[3, 4, ""] -> 
                   Directive[
                    RGBColor[
                    0.1803921568627451, 0.20392156862745098`, 
                    0.25098039215686274`], 
                    Opacity[1], 
                    AbsoluteThickness[0.5]], DirectedEdge[1, 3, ""] -> 
                   Directive[
                    RGBColor[
                    0.1803921568627451, 0.20392156862745098`, 
                    0.25098039215686274`], 
                    Opacity[1], 
                    AbsoluteThickness[0.5]]}, 
                 GraphLayout -> {
                  "LayeredDigraphEmbedding", "Orientation" -> Left}, 
                 ImageSize -> 240, PlotTheme -> "Classic", 
                 VertexLabels -> {4 -> Placed[
                    Style["", 
                    RGBColor[
                    0.1803921568627451, 0.20392156862745098`, 
                    0.25098039215686274`], 10, Bold], Center], 2 -> Placed[
                    Style["", 
