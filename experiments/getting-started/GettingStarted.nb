\\\"input\\\", \\\"send\\\": [11]},\\n\\t{\\\"component\\\": \\\"delay\\\", \
\\\"send\\\": [21], \\\"receive\\\": [11], \\\"capacity\\\": \
2.0},\\n\\t{\\\"component\\\": \\\"output\\\", \\\"receive\\\": [21]}\\n  \
]}\"\>",
