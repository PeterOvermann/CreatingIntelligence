Cell[CellGroupData[{

Cell["Category encoding", "Subsubsection",ExpressionUUID->"def6a4e1-91fe-4e9c-9e22-486cbc900cca"],

Cell["\<\
For encoding a small number of categories, non-overlapping representations \
often works better than the generic symbolic encoder discussed above. Here we \
choose a population P=10 to encode K=10 categories numbered 0 to 9. This \
requires a minimum dimension N = 100:\
\>", "Text",ExpressionUUID->"9061c8f4-fdea-428c-a5d2-e8a0235351d1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dataflow", "[", 
  RowBox[{
   RowBox[{"{", "\n", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"input", "[", 
        RowBox[{"category", ",", 
         RowBox[{"\"\<categories\>\"", " ", "->", " ", "10"}]}], "]"}], "[", 
       "11", "]"}], "[", "]"}], ",", " ", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "]"}], "[", "]"}], "[", "11", "]"}], ",", " ", 
     "\n", "\t", 
     RowBox[{"_", "->", " ", 
      RowBox[{"{", 
       RowBox[{"100", ",", "10"}], "}"}]}]}], "\n", "\t", "}"}], ",", " ", 
   "120"}], "]"}]], "Code",
 CellLabel->
  "In[5202]:=",ExpressionUUID->"8df2a195-27fc-4eae-ac1f-94895135b8b8"],

