                   None, DirectedEdge[4, 5, ""] -> None, 
                   DirectedEdge[2, 4, ""] -> None}, 
                 EdgeStyle -> {DirectedEdge[1, 4, ""] -> Directive[
                    RGBColor[
                    0.1803921568627451, 0.20392156862745098`, 
                    0.25098039215686274`], 
                    Opacity[1], 
                    AbsoluteThickness[0.5]], DirectedEdge[4, 5, ""] -> 
                   Directive[
                    RGBColor[
                    0.1803921568627451, 0.20392156862745098`, 
                    0.25098039215686274`], 
                    Opacity[1], 
                    AbsoluteThickness[0.5]], DirectedEdge[3, 4, ""] -> 
                   Directive[
                    RGBColor[
                    0.1803921568627451, 0.20392156862745098`, 
                    0.25098039215686274`], 
                    Opacity[1], 
                    AbsoluteThickness[0.5]], DirectedEdge[2, 4, ""] -> 
