Cell[CellGroupData[{

Cell["Sample-and-Hold", "Section",ExpressionUUID->"1bc1d929-56fb-409f-8650-d579115855bc"],

Cell["\<\
With the \[OpenCurlyDoubleQuote]latch\[CloseCurlyDoubleQuote] update \
mechanism plugged in, the \
\[OpenCurlyDoubleQuote]delay\[CloseCurlyDoubleQuote] component functions as a \
sample-and-hold gate, emitting the last non-empty signal when receiving empty \
input, or input below the specified population threshold.\
\>", "Text",ExpressionUUID->"155679fb-e40a-4e87-8c28-826c96d4732f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dataflow", "[", 
