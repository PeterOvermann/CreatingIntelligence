Cell["\<\
If the specified dimension N is greater than K*P,  the category encoder \
generates a random sample of the available elements:\
\>", "Text",ExpressionUUID->"a676ad7d-9fb4-4c61-8680-110fc6c7a00d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dataflow", "[", 
  RowBox[{
   RowBox[{"{", "\n", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"input", "[", 
