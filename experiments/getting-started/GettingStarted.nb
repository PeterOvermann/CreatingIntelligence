Cell["Hetero-associative memory", "Section",ExpressionUUID->"07b532b8-3551-445b-ae77-9ca9a4c9ba6f"],

Cell["\<\
Here is a basic hetero-associative memory circuit, taking two inputs and \
generating one output:\
\>", "Text",ExpressionUUID->"1cec135a-d6e5-40ed-a299-ee61a35bd6cd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dataflow", "[", 
  RowBox[{
   RowBox[{"{", " ", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"input", "[", "]"}], " ", "[", "11", "]"}], " ", "[", "]"}], ",",
      " ", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"input", "[", "]"}], " ", "[", "12", "]"}], " ", "[", "]"}], ",",
      " ", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"associator", "[", "]"}], "[", "101", "]"}], "[", 
      RowBox[{"12", ",", " ", "11"}], "]"}], ",", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "]"}], " ", "[", "]"}], " ", "[", "101", "]"}], 
     ",", "\n", "\t", 
     RowBox[{"11", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "8"}], "}"}]}], ",", "\n", "\t", 
     RowBox[{"_", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"500", ",", " ", "5"}], "}"}]}]}], "\n", "\t", "}"}], ",", " ",
    "240"}], "  ", "]"}]], "Code",
 CellLabel->
  "In[5438]:=",ExpressionUUID->"1612cfb9-3bef-4fd2-805a-9a77455e07dd"],

