Cell[CellGroupData[{

Cell["Hyper-Associative Memory", "Section",ExpressionUUID->"39526513-a8cf-43f3-b724-9813ca67c2d9"],

Cell["\<\
This sets up an auto-associative memory using the \
\[OpenCurlyDoubleQuote]complement\[CloseCurlyDoubleQuote] update rule. The \
system learns new information if it lies in the specified population range:\
\>", "Text",ExpressionUUID->"c4f6195d-8e16-4351-aa10-578286913b34"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dataflow", "[", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"input", "[", "codec", "]"}], " ", "[", "11", "]"}], " ", "[", 
      "]"}], ",", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"auto", "[", 
        RowBox[{"complement", ",", 
         RowBox[{"\"\<learn\>\"", "->", 
          RowBox[{"{", 
           RowBox[{"1.0", ",", "10.0"}], "}"}]}]}], "]"}], " ", "[", "21", 
       "]"}], " ", "[", "11", "]"}], ",", " ", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "codec", "]"}], " ", "[", "]"}], " ", "[", "21",
       "]"}], ",", "\n", "\t", 
     RowBox[{"_", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "10"}], "}"}]}]}], "\n", "\t", "}"}], ",", 
   " ", "200"}], "]"}]], "Code",
 CellLabel->
  "In[4777]:=",ExpressionUUID->"9de1a904-bafa-434f-a7d3-269ccf7e1e83"],

