Cell[CellGroupData[{

Cell["Temporal Integration", "Section",ExpressionUUID->"37383ec7-62fd-4af2-b6d4-4f22fe6e5dc5"],

Cell["\<\
The \[OpenCurlyDoubleQuote]delay\[CloseCurlyDoubleQuote] circuit component \
can accumulate  signals up to a configurable temporal capacity. By default, \
it updates the internal state with the incoming signal through a multiset \
union operation (the \[OpenCurlyDoubleQuote]augmentation\
\[CloseCurlyDoubleQuote] update rule).\
\>", "Text",ExpressionUUID->"b946c027-9381-4d70-9459-bc0f4921ce96"],

Cell["\<\
In this example, the internal capacity is twice the default population:\
\>", "Text",ExpressionUUID->"a7a99e3e-cab8-4dde-a6d8-458c673e8814"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dataflow", "[", 
  RowBox[{
   RowBox[{"{", "\n", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"input", "[", "]"}], "[", "11", "]"}], "[", "]"}], ",", " ", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"delay", "[", 
        RowBox[{"\"\<capacity\>\"", " ", "->", " ", "2.0"}], "]"}], "[", "21",
        "]"}], "[", "11", "]"}], ",", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "]"}], "[", "]"}], "[", "21", "]"}], ",", "\n", 
     "\t", 
     RowBox[{"11", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "5"}], "}"}]}], ",", "\n", "\t", 
     RowBox[{"21", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "5"}], "}"}]}]}], "\n", "\t", "}"}], ",", 
   " ", "200"}], "]"}]], "Code",
 CellLabel->
  "In[852]:=",ExpressionUUID->"2c5e1bad-d32e-418e-ba2d-68637d6c694c"],

