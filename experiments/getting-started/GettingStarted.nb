       RowBox[{"Circuit`color", "[", "3", "]"}], ",", " ", "Medium"}], 
      "]"}]}], ",", "  ", "\n", 
    RowBox[{"ItemSize", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"6", ",", "15", ",", "15"}], "}"}], "}"}]}], ",", " ", 
