     RowBox[{"11", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"400", ",", "10"}], "}"}]}], ",", "\n", "\t", 
     RowBox[{"12", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"600", ",", "10"}], "}"}]}], ",", "\n", "\t", 
     RowBox[{"101", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"700", ",", " ", "10"}], "}"}]}], ",", "\n", "\t", 
