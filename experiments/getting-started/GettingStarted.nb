      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"11", ",", "21"}], "}"}], "}"}]}], ",", 
     RowBox[{"\<\"learn\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"1.`", ",", "10.`"}], "}"}]}], ",", 
