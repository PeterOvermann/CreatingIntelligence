        "21", "]"}], " ", "[", "11", "]"}], ",", " ", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "]"}], " ", "[", "]"}], " ", "[", "21", "]"}], ",",
      "\n", "\t", 
