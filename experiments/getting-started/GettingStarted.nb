     "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"delay", "[", 
        RowBox[{"\"\<rate_limit\>\"", "->", " ", "1.4"}], "]"}], "[", "21", 
       "]"}], "[", "11", "]"}], ",", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "]"}], "[", "]"}], "[", "21", "]"}], ",", "\n", 
     "\t", 
     RowBox[{"_", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "5"}], "}"}]}]}], "\n", "\t", "}"}], ",", 
   " ", "200"}], "]"}]], "Code",
 CellLabel->
