     "                                                              ", "\n", 
     "\n", " \t   ", 
     RowBox[{"If", "[", " ", 
      RowBox[{
       RowBox[{"circuit", " ", "=!=", " ", "exprimport"}], ",", " ", "\n", 
       "\t\t\t", 
       RowBox[{
        RowBox[{"++", " ", "ERRORCOUNT"}], ";", "\n", "\t\t\t", 
