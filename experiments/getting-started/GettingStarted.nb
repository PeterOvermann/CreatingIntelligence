Cell[CellGroupData[{

Cell["Permutations", "Section",ExpressionUUID->"9e9ea3a7-f8c8-458f-af4e-9f818b2d2854"],

Cell["\<\
Pathways naturally don\[CloseCurlyQuote]t preserve the order of elements in a \
signal. This is modeled by applying set permutations. We can configure \
specific pathways to perform distinct random permutations.
In this framework, permutations are irreversible.\
\>", "Text",ExpressionUUID->"3dbc2016-9500-4c57-b43a-5b5563a19d7f"],

Cell[" Apply a permutation to the first output:", "Text",ExpressionUUID->"af4e3586-494e-4f35-9c8d-6c96aa4d2e25"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"dataflow", "[", 
   RowBox[{
    RowBox[{"{", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"input", "[", "]"}], " ", "[", "11", "]"}], " ", "[", "]"}], ",",
       " ", "\n", "\t", 
      RowBox[{
       RowBox[{
        RowBox[{"output", "[", 
         RowBox[{"\"\<label\>\"", "->", "\"\<#\>\""}], "]"}], " ", "[", "]"}],
        " ", "[", 
       RowBox[{"11", " ", "\"\<P\>\""}], "]"}], ",", "\n", "\t", 
      RowBox[{
       RowBox[{
        RowBox[{"output", "[", 
         RowBox[{"\"\<label\>\"", "->", "\"\<#\>\""}], "]"}], " ", "[", "]"}],
        " ", "[", "11", "]"}], ",", "\n", "\t", 
