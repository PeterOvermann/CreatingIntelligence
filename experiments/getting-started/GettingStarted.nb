     RowBox[{
      RowBox[{
       RowBox[{"input", "[", "vectorencoder", "]"}], "[", "11", "]"}], "[", 
      "]"}], ",", " ", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "]"}], "[", "]"}], "[", "11", "]"}], ",", " ", 
     "\n", "\t", 
