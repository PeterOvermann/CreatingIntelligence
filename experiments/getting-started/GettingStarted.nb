     "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"delay", "[", " ", 
        RowBox[{
         RowBox[{"\"\<latch\>\"", "->", "True"}], ",", " ", 
         RowBox[{"\"\<threshold\>\"", " ", "->", " ", "0.8"}]}], "]"}], "[", 
       "21", "]"}], "[", "11", "]"}], ",", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "]"}], "[", "]"}], "[", "21", "]"}], ",", "\n", 
