     "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"delay", "[", 
        RowBox[{"augmentation", ",", " ", 
         RowBox[{"\"\<capacity\>\"", " ", "->", " ", "2.0"}]}], "]"}], "[", 
       "21", "]"}], "[", "11", "]"}], ",", "\n", "\t", 
     RowBox[{
      RowBox[{
