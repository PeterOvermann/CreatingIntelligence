     "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "]"}], "[", "]"}], "[", "11", "]"}], ",", "\n", 
     "\t", 
     RowBox[{"_", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "5"}], "}"}]}]}], "\n", "\t", "}"}], ",", 
   " ", "120"}], "]"}]], "Code",
 CellLabel->
