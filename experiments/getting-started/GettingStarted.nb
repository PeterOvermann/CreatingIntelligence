     "                                                              ", "\n", 
     "\n", " \t   ", 
     RowBox[{"If", "[", " ", 
      RowBox[{
       RowBox[{"circuit", " ", "=!=", " ", "exprimport"}], ",", " ", "\n", 
       "\t\t\t", 
