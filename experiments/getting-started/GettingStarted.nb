    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\"\<!\>\"", ",", " ", "\"\<\\\"priority\\\"\>\"", 
      ",", "\"\<clears all non-! paths if any ! path is non-empty\>\""}], 
     "}"}], ",", "\[IndentingNewLine]", 
