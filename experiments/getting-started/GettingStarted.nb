 RowBox[{"dataflow", "[", 
  RowBox[{
   RowBox[{"{", "\n", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"input", "[", 
        RowBox[{"category", ",", 
         RowBox[{"\"\<categories\>\"", " ", "->", " ", "10"}]}], "]"}], "[", 
       "11", "]"}], "[", "]"}], ",", " ", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "]"}], "[", "]"}], "[", "11", "]"}], ",", " ", 
     "\n", "\t", 
     RowBox[{"_", "->", " ", 
      RowBox[{"{", 
       RowBox[{"100", ",", "10"}], "}"}]}]}], "\n", "\t", "}"}], ",", " ", 
   "120"}], "]"}]], "Code",
 CellLabel->
  "In[721]:=",ExpressionUUID->"8df2a195-27fc-4eae-ac1f-94895135b8b8"],

