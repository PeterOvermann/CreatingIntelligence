     RowBox[{
      RowBox[{
       RowBox[{"input", "[", "]"}], " ", "[", "11", "]"}], " ", "[", "]"}], ",",
      " ", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"delay", "[", "]"}], "[", "21", "]"}], "[", "11", "]"}], ",", 
     "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"delay", "[", "]"}], "[", "31", "]"}], "[", 
      RowBox[{"21", "\"\<?\>\""}], "]"}], ",", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "]"}], " ", "[", "]"}], " ", "[", "31", "]"}], ",",
      "\n", "\t", 
     RowBox[{"_", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "5"}], "}"}]}], ",", "\n", "\t", 
     RowBox[{"\"\<multiplex\>\"", " ", "->", " ", "\"\<10\>\""}]}], "\n", 
    "\t", "}"}], ",", " ", "275"}], "]"}]], "Code",
 CellLabel->
  "In[867]:=",ExpressionUUID->"454ae649-0e34-41f5-a954-4085f609ee75"],

