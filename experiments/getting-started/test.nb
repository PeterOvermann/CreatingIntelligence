         RowBox[{"ImageSize", " ", "->", " ", "size"}], "]"}], ",", " ", 
        "0.8"}], "]"}]}], ";", "\n", "\t\t", "\n", "\t\t", 
     RowBox[{"str", " ", "=", " ", 
      RowBox[{"ToJSON", "[", 
       RowBox[{"KeyDrop", "[", 
