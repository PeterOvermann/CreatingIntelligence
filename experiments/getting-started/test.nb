Cell["\<\
This circuit adds noise to the input. Note that the set notation [11,12] \
indicates pathway merging, or bundling:\
\>", "Text",ExpressionUUID->"7786fe85-3d0f-4660-b8ea-c826aae6c6c2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dataflow", "[", 
  RowBox[{
   RowBox[{"{", "\n", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"noise", "[", "]"}], "[", "11", "]"}], "[", "]"}], ",", " ", 
     "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"input", "[", "]"}], "[", "12", "]"}], "[", "]"}], ",", "\n", 
     "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "]"}], "[", "]"}], "[", 
      RowBox[{"{", 
       RowBox[{"11", ",", "12"}], "}"}], "]"}], ",", "\n", "\t", 
