 InterpretationBox[
  RowBox[{"\<\"config = \"\>", "\[InvisibleSpace]", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"component\"\>", "\[Rule]", "auto"}], ",", 
     RowBox[{"\<\"send\"\>", "\[Rule]", 
      RowBox[{"{", "21", "}"}]}], ",", 
     RowBox[{"\<\"receive\"\>", "\[Rule]", 
      RowBox[{"{", "11", "}"}]}], ",", 
     RowBox[{"\<\"threshold\"\>", "\[Rule]", "1.`"}], ",", 
     RowBox[{"\<\"receive_paths\"\>", "\[Rule]", 
      RowBox[{"{", "1", "}"}]}], ",", 
     RowBox[{"\<\"node_id\"\>", "\[Rule]", "2"}], ",", 
     RowBox[{"\<\"send_slots\"\>", "\[Rule]", 
      RowBox[{"{", "21", "}"}]}], ",", 
     RowBox[{"\<\"scale\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"1000", ",", "10"}], "}"}]}], ",", 
     RowBox[{"\<\"receive_blocks\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1000", ",", "10"}], "}"}], "}"}]}], ",", 
     RowBox[{"\<\"send_blocks\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1000", ",", "10"}], "}"}], "}"}]}]}], 
    "\[RightAssociation]"}]}],
  SequenceForm[
  "config = ", <|
   "component" -> $CellContext`auto, "send" -> {21}, "receive" -> {11}, 
    "threshold" -> 1., "receive_paths" -> {1}, "node_id" -> 2, 
    "send_slots" -> {21}, "scale" -> {1000, 10}, 
    "receive_blocks" -> {{1000, 10}}, "send_blocks" -> {{1000, 10}}|>],
  Editable->False]], "Print",
 CellLabel->
