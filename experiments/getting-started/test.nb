     RowBox[{
      RowBox[{
       RowBox[{"input", "[", "]"}], " ", "[", "11", "]"}], " ", "[", "]"}], ",",
      " ", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"auto", "[", 
        RowBox[{"\"\<learn\>\"", "->", " ", 
