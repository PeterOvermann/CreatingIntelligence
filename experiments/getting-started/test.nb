        RowBox[{"1", ",", "2"}], "}"}], "}"}]}], ",", 
     RowBox[{"\<\"node_id\"\>", "\[Rule]", "2"}], ",", 
     RowBox[{"\<\"send_slots\"\>", "\[Rule]", 
      RowBox[{"{", "21", "}"}]}], ",", 
     RowBox[{"\<\"scale\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"1000", ",", "10"}], "}"}]}], ",", 
