       RowBox[{"output", "[", "]"}], "[", "]"}], "[", 
      RowBox[{"21", " ", "\"\<+\>\""}], "]"}], ",", "\n", "\t", 
     RowBox[{"_", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "5"}], "}"}]}]}], "\n", "\t", "}"}], ",", 
   " ", "200"}], "]"}]], "Code",
