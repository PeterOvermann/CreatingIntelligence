Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"config = \"\>", "\[InvisibleSpace]", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"component\"\>", "\[Rule]", "auto"}], ",", 
     RowBox[{"\<\"plugin\"\>", "\[Rule]", "replacement"}], ",", 
     RowBox[{"\<\"send\"\>", "\[Rule]", 
      RowBox[{"{", "21", "}"}]}], ",", 
     RowBox[{"\<\"receive\"\>", "\[Rule]", 
      RowBox[{"{", "11", "}"}]}], ",", 
     RowBox[{"\<\"receive_paths\"\>", "\[Rule]", 
      RowBox[{"{", "1", "}"}]}], ",", 
     RowBox[{"\<\"node_id\"\>", "\[Rule]", "2"}], ",", 
     RowBox[{"\<\"send_slots\"\>", "\[Rule]", 
      RowBox[{"{", "21", "}"}]}], ",", 
     RowBox[{"\<\"scale\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"1000", ",", "10"}], "}"}]}], ",", 
     RowBox[{"\<\"receive_blocks\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1000", ",", "10"}], "}"}], "}"}]}], ",", 
     RowBox[{"\<\"send_blocks\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1000", ",", "10"}], "}"}], "}"}]}]}], 
    "\[RightAssociation]"}]}],
  SequenceForm[
