     RowBox[{"If", "[", " ", 
      RowBox[{
       RowBox[{"circuit", " ", "=!=", " ", "dfdexpr"}], ",", " ", "\n", 
       "\t\t\t", 
       RowBox[{
        RowBox[{"++", " ", "ERRORCOUNT"}], ";", "\n", "\t\t\t", 
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"Circuit", "::", "regress"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"circuit", ",", " ", "dfdexpr"}], "}"}]}], "]"}], ";"}]}], 
      "\n", "\t\t\t", "]"}], ";", "\n", "             ", "\n", "        ", 
     RowBox[{"(*", " ", 
      RowBox[{"Verify", " ", "JSON", " ", 
       RowBox[{"Export", "/", "Import"}], " ", 
       RowBox[{"roundtrip", "."}]}], " ", "*)"}], "\n", "\n", "        ", 
     RowBox[{"jsonstr", " ", "=", " ", 
      RowBox[{"ExportString", "[", 
       RowBox[{"circuit", ",", " ", "\"\<Circuit\>\""}], "]"}]}], ";", "   ", 
     "\n", "        ", 
     RowBox[{"exprimport", " ", "=", " ", 
      RowBox[{"ImportString", "[", 
       RowBox[{"jsonstr", ",", " ", "\"\<Circuit\>\""}], "]"}]}], ";", 
     "                                                              ", "\n", 
     "\n", " \t   ", 
     RowBox[{"If", "[", " ", 
      RowBox[{
       RowBox[{"circuit", " ", "=!=", " ", "exprimport"}], ",", " ", "\n", 
       "\t\t\t", 
       RowBox[{
        RowBox[{"++", " ", "ERRORCOUNT"}], ";", "\n", "\t\t\t", 
        RowBox[{"Print", "[", "\"\<JSON Roundtrip Error\>\"", "]"}], ";", 
        "\n", "\t\t\t", "\n", "\t\t\t", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<circuit = \>\"", ",", " ", 
          RowBox[{"InputForm", "[", "circuit", "]"}]}], "]"}], ";", "\n", 
        "\t\t\t", 
        RowBox[{"Print", "[", "]"}], ";", "\n", "\t\t\t", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<exprimport = \>\"", ",", " ", 
          RowBox[{"InputForm", "[", "exprimport", "]"}]}], "]"}], ";", "\n", 
        "\t\t\t", 
        RowBox[{"Print", "[", "]"}], ";", "\n", "\t\t\t", 
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"Circuit", "::", "regress"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"exprimport", ",", " ", "circuit"}], "}"}]}], "]"}]}]}], 
      "\n", "\t\t\t", "]"}], ";", "\n", "\n", "\t\t", 
     RowBox[{"(*", " ", 
      RowBox[{"Clear", " ", "previous", " ", 
       RowBox[{"circuit", "."}]}], " ", "*)"}], "\n", "\t\t", 
     RowBox[{"CIRCUIT", "[", "\"\<clear\>\"", "]"}], ";", "\n", "\t\t", "\n", 
     "\t\t", 
     RowBox[{"(*", " ", 
      RowBox[{"Instantiate", " ", "current", " ", 
       RowBox[{"circuit", "."}]}], " ", "*)"}], "\n", "\t\t", 
     RowBox[{"CIRCUIT", " ", "=", " ", 
      RowBox[{"Circuit", "[", "circuit", "]"}]}], ";", "\n", "\t\t", 
     RowBox[{"CIRCUITCOUNT", "++"}], ";", "\n", "        ", "\n", "\t\t", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"Magnify", "[", 
       RowBox[{
