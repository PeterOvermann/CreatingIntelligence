Cell[CellGroupData[{

Cell["Data routing and merging", "Subsubsection",ExpressionUUID->"b80de31a-ae0c-453b-960c-ec2d5f6220e5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"table3", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\"\<X\>\"", ",", "\"\<\\\"veto\\\"\>\"", 
      ",", "\"\<clears all paths if any X path is non-empty\>\""}], "}"}], ",",
     " ", "\n", 
    RowBox[{"{", 
     RowBox[{"\"\<*\>\"", ",", " ", "\"\<\\\"mandatory\\\"\>\"", 
      ",", "\"\<clears all paths if any * path is empty\>\""}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\"\<!\>\"", ",", " ", "\"\<\\\"priority\\\"\>\"", 
      ",", "\"\<clears all non-! paths if any ! path is non-empty\>\""}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\"\<&\>\"", ",", " ", "\"\<\\\"dependency\\\"\>\"", ",", 
      " ", "\"\<clears & paths if any non-& path is empty (AND)\>\""}], "}"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\"\<|\>\"", ",", " ", "\"\<\\\"fallback\\\"\>\"", ",", 
      " ", "\"\<clears | paths if any non-| path is non-empty (NOR)\>\""}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\"\<=\>\"", ",", " ", "\"\<\\\"barrier\\\"\>\"", ",", 
      " ", "\"\<clears = paths if any = path is empty\>\""}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\"\<K\>\"", ",", " ", "\"\<\\\"kwta_excitatory\\\"\>\"", ",", 
      " ", "\"\<top-k excitatory (positive) signals\>\""}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\"\<k\>\"", ",", " ", "\"\<\\\"kwta_absolute\\\"\>\"", ",", 
      " ", "\"\<top-k signals (total saliency)\>\""}], "}"}]}], "}"}], 
  "]"}]], "Code",
 CellLabel->
  "In[2239]:=",ExpressionUUID->"81fea832-ca37-47d0-9966-8df4a869aa8a"],

Cell[BoxData[
 TagBox[GridBox[{
    {Cell["X",ExpressionUUID->"23ff5552-a877-453f-b608-a56879d03a27"], Cell[
     "\"veto\"",ExpressionUUID->"0a467682-5226-458a-8d18-403245ef6963"], Cell[
     "clears all paths if any X path is non-empty",ExpressionUUID->
      "fe56a550-c735-4bf3-b199-25b7088bf10c"]},
    {Cell["*",ExpressionUUID->"f96fb323-deb3-4c0c-92a5-eaa7fe2efd78"], Cell[
     "\"mandatory\"",ExpressionUUID->"ffce29df-3750-4ff3-9657-5f0747064051"], 
     Cell["clears all paths if any * path is empty",ExpressionUUID->
      "2f6e78d2-798b-4bf1-9f26-b85dff528c04"]},
    {Cell["!",ExpressionUUID->"94d7ad05-0428-453f-abdf-47306ca97e5c"], Cell[
     "\"priority\"",ExpressionUUID->"14150206-ac02-4ac0-905f-790d90400a99"], 
     Cell["clears all non-! paths if any ! path is non-empty",ExpressionUUID->
      "83c91687-fca0-4bd4-a1fb-fcb79c7615da"]},
    {Cell["&",ExpressionUUID->"1b7f0c1d-4d3c-479c-9a84-38424dcbab98"], Cell[
     "\"dependency\"",ExpressionUUID->"d5094a5f-d8e3-451e-bbe3-5809d0b84fc2"],
      Cell["clears & paths if any non-& path is empty (AND)",ExpressionUUID->
      "67d04d3d-9a1c-468d-82ae-e41918f3475a"]},
    {Cell["|",ExpressionUUID->"a8b50054-d6db-42f3-8715-8525dce7f571"], Cell[
     "\"fallback\"",ExpressionUUID->"6e418259-3835-42b4-bf29-2e0e9878c747"], 
     Cell["clears | paths if any non-| path is non-empty (NOR)",
      ExpressionUUID->"174cc656-b062-4176-baf2-8c9092af8c82"]},
    {Cell["=",ExpressionUUID->"eb7a5671-10c8-456a-859e-6e138214f63e"], Cell[
     "\"barrier\"",ExpressionUUID->"b02f91d0-7ede-46ca-a36b-c887e8e4817a"], 
     Cell["clears = paths if any = path is empty",ExpressionUUID->
      "1f39e296-87e2-454e-af92-316c1ae1d712"]},
    {Cell["K",ExpressionUUID->"358e8b6a-5481-45ae-917d-2add50819f03"], Cell[
