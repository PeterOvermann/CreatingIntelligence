Cell["Dataset", "Subsection",ExpressionUUID->"4d27fc5b-ff63-4dd1-9cd3-d01f4584a70b"],

Cell["A sequence of 1000 random digits:", "Text",ExpressionUUID->"ad453c0d-aa19-4af7-92ec-65374d74dbbb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dataset", " ", "=", " ", 
   RowBox[{"RandomInteger", "[", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "10"}], "}"}], ",", " ", "1000"}], "]"}]}], 
  ";"}]], "Code",
 CellLabel->
  "In[2329]:=",ExpressionUUID->"e806d413-0c92-4cc7-9b23-4fc824eb8759"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Prediction score", "Subsection",ExpressionUUID->"43b23ddc-096d-451f-92cd-c27b2a89dbd7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Do", "[", " ", "\n", "\t", 
   RowBox[{
    RowBox[{
     RowBox[{"predictions", " ", "=", " ", 
      RowBox[{"f", " ", "/@", " ", "dataset"}]}], ";", " ", "\n", "\t", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<    iteration = \>\"", ",", " ", "i", ",", " ", "\n", 
       "\t", "\"\<, prediction score = \>\"", ",", " ", 
       RowBox[{"N", "[", 
        RowBox[{"Mean", "@", 
         RowBox[{"Boole", "@", 
          RowBox[{"MapThread", "[", 
           RowBox[{"SameQ", ",", " ", "\n", "\t\t", 
            RowBox[{"{", 
             RowBox[{"dataset", ",", " ", 
              RowBox[{"RotateRight", "[", "predictions", "]"}]}], "}"}]}], 
           "]"}]}]}], "]"}]}], "]"}]}], ",", " ", "\n", "\t", 
    RowBox[{"{", 
     RowBox[{"i", ",", " ", "1", ",", " ", "5"}], "}"}]}], "]"}], 
  ";"}]], "Code",
 CellLabel->
  "In[2330]:=",ExpressionUUID->"d1e2c6d5-9295-420f-9498-3927ef0f8727"],

