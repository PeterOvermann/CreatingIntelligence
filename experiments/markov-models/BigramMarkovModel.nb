Cell["\<\
jsonstr = 

{
  \"$schema\": \"https://creatingintelligence.org/schemas/circuit-v1.json\",

  \"hyperparameters\": {\"default\": [2000, 8]},

  \"dataflow\": [
\t{\"component\": \"input\", \"plugin\": \"codec\", \"send\": [11]},

\t{\"component\": \"delay\", \"send\": [21], \"receive\": [11]},

\t{\"component\": \"heteroencoder\", \"send\": [51], \"receive\": [11, 21]},

\t{\"component\": \"delay\", \"send\": [61], \"receive\": [[51, {\"slot\": \
62, \"tags\": [\"permute\"]}]]},

\t{\"component\": \"delay\", \"send\": [62], \"receive\": [61], \
\"rate_limit\": 3.0},

\t{\"component\": \"temporal\", \"send\": [101], \"receive\": [11, 61]},

\t{\"component\": \"output\", \"plugin\": \"codec\", \"receive\": [101]}
  ]
}\
\>", "Program",
 GeneratedCell->True,
 CellAutoOverwrite->
  True,ExpressionUUID->"695adc11-d97c-4049-bf32-1d7bbe1a8ba5"],

