Cell["\<\
jsonstr = 

{
  \"$schema\": \"https://creatingintelligence.org/schemas/circuit-v1.json\",

  \"hyperparameters\": {\"default\": [2000, 10]},

  \"dataflow\": [
\t{\"component\": \"input\", \"plugin\": \"codec\", \"send\": [11]},

\t{\"component\": \"delay\", \"send\": [51], \"receive\": [[11, {\"slot\": \
51, \"tags\": [\"permute\"]}]], \"rate_limit\": 6},

\t{\"component\": \"predictor\", \"send\": [101], \"receive\": [11, 51]},

\t{\"component\": \"output\", \"plugin\": \"codec\", \"receive\": [101]}
  ]
}\
\>", "Program",
 GeneratedCell->True,
 CellAutoOverwrite->
  True,ExpressionUUID->"e3eadcb6-b305-4199-a7de-6138f72816ff"],

