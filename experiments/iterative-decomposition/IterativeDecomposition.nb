Cell[CellGroupData[{

Cell["Circuit", "Subsection",ExpressionUUID->"55a437b1-38f8-4e60-9875-98da51557600"],

Cell["\<\


{
  \"$schema\": \"https://creatingintelligence.org/schemas/circuit-v1.json\",

  \"hyperparameters\": {\"default\": [2000, 10]},

  \"dataflow\": [
\t{\"component\": \"input\", \"plugin\": \"codec\", \"send\": [11]},

\t{\"component\": \"delay\", \"send\": [21], \"receive\": [[{\"slot\": 11, \
\"tags\": [\"priority\"]}, 21, {\"slot\": 31, \"tags\": [\"inhibit\"]}]]},

\t{\"component\": \"auto\", \"send\": [31], \"receive\": [[21, {\"slot\": 31, \
\"tags\": [\"inhibit\"]}]], \"decimate\": 0.8},

\t{\"component\": \"output\", \"plugin\": \"codec\", \"receive\": [31]}
  ]
}


\
\>", "Program",ExpressionUUID->"05c8148c-4479-4e6b-a82d-1b462c2bc3a6"],

