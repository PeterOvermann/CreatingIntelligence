        " ", "\"\<distance\>\"", ",", " ", "\"\<overlap\>\""}], "}"}]}], ";", 
     "\n", "\n", "\t\t", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<|\>\"", " ", "<>", " ", 
       RowBox[{"StringJoin", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"StringPadLeft", "[", 
            RowBox[{
             RowBox[{"#", " ", "<>", " ", "\"\< \>\""}], ",", " ", "12"}], 
            "]"}], " ", "<>", " ", "\"\<|\>\""}], " ", "&"}], " ", "/@", " ", 
         "cols"}], "]"}]}], "]"}], ";", "\n", "\t\t", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<|\>\"", " ", "<>", " ", 
       RowBox[{"StringRepeat", "[", 
        RowBox[{"\"\<------------|\>\"", ",", " ", 
         RowBox[{"Length", "[", "cols", "]"}]}], "]"}]}], "]"}], ";", 
     "\t\t\t\t", "\n", "\n", "\t\t", 
     RowBox[{"Do", "[", " ", "\n", "\n", "\t\t", 
      RowBox[{
       RowBox[{
        RowBox[{"data", " ", "=", " ", 
         RowBox[{"Table", "[", " ", 
          RowBox[{
           RowBox[{"RandomAssociation", "[", "mem", "]"}], ",", " ", "size"}],
           "]"}]}], ";", " ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        "\t\t", 
        RowBox[{"storetime", " ", "=", " ", 
         RowBox[{"First", "[", 
          RowBox[{"AbsoluteTiming", "[", " ", 
           RowBox[{
            RowBox[{"mem", "[", "\"\<store\>\"", "]"}], " ", "@@@", " ", 
            "data"}], "]"}], "]"}]}], ";", " ", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "\t\t", 
        RowBox[{"inp", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"AddNoise", "[", 
            RowBox[{"#", " ", ",", " ", 
             RowBox[{"mem", "[", "\"\<A_parameters\>\"", "]"}], ",", " ", 
             RowBox[{"config", "[", "\"\<noise\>\"", "]"}]}], "]"}], " ", 
           "&"}], " ", "/@", " ", 
          RowBox[{"data", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\t\t", 
        RowBox[{"retrievetime", " ", "=", " ", 
         RowBox[{"First", "[", 
          RowBox[{"AbsoluteTiming", "[", " ", 
           RowBox[{"out", " ", "=", " ", 
            RowBox[{
             RowBox[{"mem", "[", "\"\<retrieve\>\"", "]"}], " ", "/@", " ", 
             "inp"}]}], " ", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "\t\t", 
        RowBox[{"distance", " ", "=", " ", 
         RowBox[{"Total", "[", 
          RowBox[{"Table", "[", " ", 
           RowBox[{
            RowBox[{"Distance", "[", 
             RowBox[{
              RowBox[{"out", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
              RowBox[{"data", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "1", ",", " ", "size"}], "}"}]}], "]"}], 
          "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", "\t\t", 
        
        RowBox[{"overlap", " ", "=", " ", 
         RowBox[{"Total", "[", 
          RowBox[{"Table", "[", " ", 
           RowBox[{
            RowBox[{"Overlap", "[", 
             RowBox[{
              RowBox[{"out", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
              RowBox[{"data", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "1", ",", " ", "size"}], "}"}]}], "]"}], 
          "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", "\t\t", 
        
        RowBox[{"Print", "[", " ", 
         RowBox[{"\"\<|\>\"", ",", "\[IndentingNewLine]", "\t\t\t", 
          RowBox[{"PaddedForm", "[", " ", 
           RowBox[{
            RowBox[{"iter", "*", "size"}], ",", " ", "10"}], "]"}], ",", 
          " ", "\"\< |\>\"", ",", " ", "\[IndentingNewLine]", "\t\t\t", 
          RowBox[{"PaddedForm", "[", " ", 
           RowBox[{
            RowBox[{"Round", "[", 
             RowBox[{"size", "/", "storetime"}], "]"}], ",", "10"}], "]"}], ",",
           " ", "\"\< |\>\"", ",", " ", "\n", "\t\t\t", 
          RowBox[{"StringPadLeft", "[", 
           RowBox[{
            RowBox[{"ToString", "[", 
             RowBox[{"DecimalForm", "[", " ", 
              RowBox[{
               RowBox[{"N", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"mem", "[", "\"\<memorycount\>\"", "]"}], "/", 
                  "memsize"}], ",", " ", "6"}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"10", ",", "6"}], "}"}]}], "]"}], "]"}], ",", " ", 
            "11"}], "]"}], ",", " ", "\"\< |\>\"", ",", " ", "\n", "\t\t\t", 
          RowBox[{"PaddedForm", "[", " ", 
           RowBox[{
            RowBox[{"Round", "[", " ", 
             RowBox[{"size", "/", "retrievetime"}], "]"}], ",", " ", "10"}], 
           "]"}], ",", " ", "\"\< |\>\"", ",", " ", "\[IndentingNewLine]", 
          "\t\t\t", 
          RowBox[{"PaddedForm", "[", " ", 
