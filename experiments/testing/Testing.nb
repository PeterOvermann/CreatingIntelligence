     RowBox[{"Print", "[", "]"}], ";", "\n", "\t\t", "\n", "\t\t", 
     RowBox[{"cols", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<items\>\"", ",", " ", "\"\<writes/s\>\"", ",", 
