           RowBox[{"mem", "[", "\"\<A_parameters\>\"", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "1"}], ")"}], " ", "/",
         " ", "2"}]}]}], ";", "\n", "\t", "\n", "\t\t", 
     RowBox[{"size", " ", "=", " ", 
      RowBox[{"config", "[", "\"\<batchsize\>\"", "]"}]}], ";", "\n", "\n", 
     "\t\t", 
