Cell[BoxData[
 RowBox[{
  RowBox[{"dataset", " ", "=", " ", 
   RowBox[{"RandomChoice", "[", " ", 
    RowBox[{"chars", ",", " ", "2000"}], "]"}]}], ";"}]], "Code",
 CellLabel->
  "In[4011]:=",ExpressionUUID->"e806d413-0c92-4cc7-9b23-4fc824eb8759"]
