Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"chars", " ", "=", " ", 
  RowBox[{"CharacterRange", "[", 
   RowBox[{"\"\<A\>\"", ",", " ", "\"\<Z\>\""}], "]"}]}]], "Code",
