Cell[CellGroupData[{

Cell["Circuit", "Subsection",ExpressionUUID->"ff6f1c84-5833-4243-b9f6-8ced7d48a5ae"],

Cell["\<\


{
  \"$schema\": \"https://creatingintelligence.org/schemas/circuit-v1.json\",

  \"hyperparameters\": {\"default\": [2000, 10]},

  \"dataflow\": [
\t{\"component\": \"input\", \"plugin\": \"codec\", \"send\": [11]},

\t{\"component\": \"delay\", \"send\": [51], 
\t       \"receive\": [[11, {\"slot\": 51, \"tags\": [\"permute\"]}]], \
\"rate_limit\": 6.0},

\t{\"component\": \"predictor\", \"send\": [101], \"receive\": [11, 51]},

\t{\"component\": \"output\", \"plugin\": \"codec\", \"receive\": [101]}
  ]
}
\
\>", "Program",ExpressionUUID->"49a42a6d-5c2a-4241-860c-777a8d36858c"],

