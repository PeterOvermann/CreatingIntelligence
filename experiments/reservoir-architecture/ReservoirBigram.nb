 RowBox[{"<<", " ", "\"\<Circuits.m\>\""}]], "Code",
 CellLabel->"In[94]:=",ExpressionUUID->"9de35f9b-c211-4c25-9a7c-7cf15174be8c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Circuit", "Subsection",ExpressionUUID->"1729613a-a3b8-4ec9-b030-fd12d756b5b2"],

Cell["\<\


{
  \"$schema\": \"https://creatingintelligence.org/schemas/circuit-v1.json\",

  \"hyperparameters\": {\"default\": [2000, 8]},

  \"dataflow\": [
\t{\"component\": \"input\", \"plugin\": \"codec\", \"send\": [11]},

\t{\"component\": \"delay\", \"send\": [21], \"receive\": [11]},

\t{\"component\": \"heteroencoder\", \"send\": [51], \"receive\": [11, 21]},

\t{\"component\": \"delay\", \"send\": [61], \"receive\": [[51, {\"slot\": \
62, \"tags\": [\"permute\"]}]]},

\t{\"component\": \"delay\", \"send\": [62], \"receive\": [61], \
\"rate_limit\": 3.0},

\t{\"component\": \"predictor\", \"send\": [101], \"receive\": [11, [11, 61]]},

\t{\"component\": \"output\", \"plugin\": \"codec\", \"receive\": [101]}
  ]
}

\
\>", "Program",ExpressionUUID->"7f26f0a8-ce57-4f0e-85da-ea320eed9a6b"],

