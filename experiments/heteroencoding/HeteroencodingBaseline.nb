}, Open  ]],

Cell[CellGroupData[{

Cell["Circuit", "Subsection",ExpressionUUID->"a9ade696-9139-47e1-8357-115667a99301"],

Cell["\<\


{
  \"$schema\": \"https://creatingintelligence.org/schemas/circuit-v1.json\",

  \"hyperparameters\": {\"11\": [1000, 30], \"12\": [1000, 30], \"21\": \
[1000, 10], \"101\": [500, 5]},

  \"dataflow\": [
\t{\"component\": \"noise\", \"send\": [11]},

\t{\"component\": \"noise\", \"send\": [12]},

\t{\"component\": \"input\", \"plugin\": \"codec\", \"send\": [21]},

\t{\"component\": \"heteroencoder\", \"send\": [101], \"receive\": [[11, \
{\"slot\": 12, \"tags\": [\"inhibit\"]}, 21]]},

\t{\"component\": \"output\", \"plugin\": \"binning\", \"receive\": [101]}
  ]
}

\
\>", "Program",ExpressionUUID->"48b41df4-d24e-46f3-99dd-e7387fa5671c"],

