 CellLabel->"In[3]:=",ExpressionUUID->"9de35f9b-c211-4c25-9a7c-7cf15174be8c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Circuit", "Subsection",ExpressionUUID->"99abcf46-cee5-48cc-9e4a-f57f0c352798"],

Cell["\<\


{
  \"$schema\": \"https://creatingintelligence.org/schemas/circuit-v1.json\",

  \"hyperparameters\": {\"12\": [16000, 160], \"default\": [150, 15]},

  \"dataflow\": [
\t{\"component\": \"input\", \"plugin\": \"category\", \"send\": [11], \
\"categories\": 10},

\t{\"component\": \"input\", \"plugin\": \"vectorencoder\", \"send\": [12]},

\t{\"component\": \"associator\", \"send\": [101], \"receive\": [{\"slot\": \
11, \"tags\": [\"show_population\"]}, {\"slot\": 12, \"tags\": \
[\"show_population\"]}]},

\t{\"component\": \"output\", \"plugin\": \"category\", \"receive\": [{\"slot\
\": 101, \"tags\": [\"show_population\"]}], \"categories\": 10}
  ]
}

\
\>", "Program",ExpressionUUID->"e6babfa4-0448-4dbb-b93a-bc9fb7fecf77"],

