Cell[CellGroupData[{

Cell["Format data and output side-by-side", "Subsection",ExpressionUUID->"d0c5b93d-fc4b-4a73-8e9b-d01036b774c4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ArrayToMarkdownTable", "[", 
   RowBox[{"inputs_List", ",", " ", "out_List", ",", " ", 
    RowBox[{"predictiveQ_", " ", ":", " ", "False"}]}], "]"}], " ", ":=", " ",
   "\n", "\t", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "outputs", ",", " ", "combinedRaw", ",", " ", "headerRaw", ",", " ", 
      "allRows", ",", " ", "colWidths", ",", " ", "paddedTransposed", ",", 
      " ", "paddedRows", ",", " ", "separatorRow", ",", " ", "formatRow"}], 
     "}"}], ",", "\n", "  ", "\n", "  ", 
    RowBox[{
     RowBox[{"outputs", " ", "=", " ", "out"}], ";", "\n", "  ", "\n", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{"align", " ", "input", " ", "and", " ", "output", " ", "rows"}],
       " ", "*)"}], "\n", "  ", 
     RowBox[{"If", "[", " ", 
      RowBox[{"predictiveQ", ",", " ", 
       RowBox[{
        RowBox[{"outputs", " ", "=", " ", 
         RowBox[{"RotateRight", "[", "outputs", "]"}]}], ";", " ", "\n", "  ", 
        RowBox[{
         RowBox[{"outputs", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "=", " ", 
         RowBox[{
          RowBox[{"Null", "&"}], " ", "/@", " ", 
          RowBox[{"outputs", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}]}]}]}], "]"}], ";", "\n", "  ", 
     "\n", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Convert", " ", "all", " ", "elements", " ", "to", " ", "strings"}], 
      " ", "*)"}], "\n", "  ", 
     RowBox[{"combinedRaw", " ", "=", " ", 
      RowBox[{"Map", "[", 
       RowBox[{"ToString", ",", " ", 
        RowBox[{"Join", "[", 
         RowBox[{"inputs", ",", " ", "outputs", ",", " ", "2"}], "]"}], ",", 
        " ", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\n", "  ", "\n", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{"Generate", " ", "header", " ", "row"}], " ", "*)"}], "\n", 
     "  ", 
     RowBox[{"headerRaw", " ", "=", " ", 
      RowBox[{"Join", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"ConstantArray", "[", 
         RowBox[{"\"\<in\>\"", ",", " ", 
          RowBox[{"Length", "[", 
           RowBox[{"First", "[", "inputs", "]"}], "]"}]}], "]"}], ",", "\n", 
        "    ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"\"\<out\>\"", ",", " ", 
          RowBox[{"Length", "[", 
           RowBox[{"First", "[", "outputs", "]"}], "]"}]}], "]"}]}], "\n", 
       "  ", "]"}]}], ";", "\n", "  ", "\n", "  ", 
     RowBox[{"allRows", " ", "=", " ", 
      RowBox[{"Prepend", "[", 
       RowBox[{"combinedRaw", ",", " ", "headerRaw"}], "]"}]}], ";", "\n", 
     "  ", "\n", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Calculate", " ", "maximum", " ", "string", " ", "length", " ", "per", " ",
        "column", " ", 
       RowBox[{"(", 
        RowBox[{
        "minimum", " ", "3", " ", "for", " ", "Markdown", " ", "separator"}], 
        ")"}]}], " ", "*)"}], "\n", "  ", 
     RowBox[{"colWidths", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"3", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
       RowBox[{"Map", "[", 
        RowBox[{"Max", ",", " ", 
         RowBox[{"Map", "[", 
          RowBox[{"StringLength", ",", " ", 
           RowBox[{"Transpose", "[", "allRows", "]"}], ",", " ", 
           RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}]}]}], ";", "\n", "  ", 
     "\n", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Pad", " ", "strings", " ", "to", " ", "match", " ", "the", " ", "max", 
       " ", "width", " ", "of", " ", "their", " ", "respective", " ", 
       "columns"}], " ", "*)"}], "\n", "  ", 
     RowBox[{"paddedTransposed", " ", "=", " ", 
      RowBox[{"MapThread", "[", 
       RowBox[{"StringPadRight", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Transpose", "[", "allRows", "]"}], ",", " ", "colWidths"}],
          "}"}]}], "]"}]}], ";", "\n", "  ", 
     RowBox[{"paddedRows", " ", "=", " ", 
      RowBox[{"Transpose", "[", "paddedTransposed", "]"}]}], ";", "\n", "  ", 
     "\n", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Generate", " ", "separator", " ", "row", " ", "with", " ", "correctly",
        " ", "sized", " ", "dash", " ", "strings"}], " ", "*)"}], "\n", "  ", 
     
     RowBox[{"separatorRow", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"StringPadRight", "[", 
         RowBox[{"\"\<\>\"", ",", " ", "#", ",", " ", "\"\<-\>\""}], "]"}], 
        " ", "&"}], " ", "/@", " ", "colWidths"}]}], ";", "\n", "  ", "\n", 
     "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Format", " ", "a", " ", "single", " ", "row", " ", "with", " ", 
       "Markdown", " ", "pipes"}], " ", "*)"}], "\n", "  ", 
     RowBox[{
      RowBox[{"formatRow", "[", "row_", "]"}], " ", ":=", " ", 
      RowBox[{"\"\<| \>\"", " ", "<>", " ", 
       RowBox[{"StringRiffle", "[", 
        RowBox[{"row", ",", " ", "\"\< | \>\""}], "]"}], " ", "<>", 
       " ", "\"\< |\>\""}]}], ";", "\n", "  ", "\n", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "Insert", " ", "separator", " ", "between", " ", "header", " ", "and", 
        " ", "body"}], ",", " ", 
       RowBox[{"then", " ", "format", " ", "and", " ", "join"}]}], " ", 
      "*)"}], "\n", "  ", 
     RowBox[{"StringRiffle", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"formatRow", " ", "/@", " ", 
        RowBox[{"Insert", "[", 
         RowBox[{"paddedRows", ",", " ", "separatorRow", ",", " ", "2"}], 
         "]"}]}], ",", " ", "\n", "    ", "\"\<\\n\>\""}], "\n", "  ", 
      "]"}]}]}], "\n", "]"}]}]], "Code",
 CellLabel->"In[25]:=",ExpressionUUID->"8b12a60b-a5db-4227-bfab-fc755f1c856f"],

