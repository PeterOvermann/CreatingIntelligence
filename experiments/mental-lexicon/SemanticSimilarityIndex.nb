Cell[BoxData[
 RowBox[{
  RowBox[{"SimilarityMatrix", "[", " ", "items_List", "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"simtable", ",", " ", "xTicks", ",", " ", "yTicks"}], "}"}], ",",
     "\n", "\t", "\n", "\t", 
    RowBox[{
     RowBox[{"simtable", " ", "=", " ", 
      RowBox[{"Outer", "[", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Round", "[", 
          RowBox[{
           RowBox[{"similarity", "[", "##", "]"}], ",", " ", "0.001"}], "]"}],
          "&"}], ",", " ", "items", ",", " ", "items"}], "]"}]}], ";", " ", 
     "\n", "\t", 
     RowBox[{"xTicks", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Rotate", "[", 
           RowBox[{
            RowBox[{"items", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", 
            RowBox[{"90", " ", "Degree"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "items", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\n", "\t", 
     RowBox[{"yTicks", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"items", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "items", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\n", "\t", "\n", "\t", 
     RowBox[{"MatrixPlot", "[", 
      RowBox[{"simtable", ",", " ", "\n", "\t\t", 
       RowBox[{"FrameTicks", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"yTicks", ",", " ", "None"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"None", ",", " ", "xTicks"}], "}"}]}], "}"}]}], ",", 
       "\[IndentingNewLine]", "\t\t", 
       RowBox[{"FrameStyle", " ", "->", " ", 
        RowBox[{"Opacity", "[", "0", "]"}]}], ",", "\n", "\t\t", 
