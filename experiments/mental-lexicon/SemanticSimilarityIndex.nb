Cell[CellGroupData[{

Cell["Circuit", "Subsection",ExpressionUUID->"55a437b1-38f8-4e60-9875-98da51557600"],

Cell["\<\

{
  \"$schema\": \"https://creatingintelligence.org/schemas/circuit-v1.json\",

  \"hyperparameters\": {\"default\": [5000, 10]},

  \"dataflow\": [
\t{\"component\": \"input\", \"plugin\": \"codec\", \"send\": [1]},

\t{\"component\": \"input\", \"plugin\": \"codec\", \"send\": [2]},

\t{\"component\": \"associator\", \"send\": [11], \"receive\": [2, 1]},

\t{\"component\": \"output\", \"receive\": [11]}
  ]
}

\
\>", "Program",ExpressionUUID->"6b5a1d3e-5aee-4be0-989e-697f67e87f7e"],

