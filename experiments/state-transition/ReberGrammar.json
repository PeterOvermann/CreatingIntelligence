{
  "$schema": "https://creatingintelligence.org/schemas/circuit-v1.json",

  "hyperparameters": {"default": [2000, 10]},

  "dataflow": [
	{"component": "input", "plugin": "codec", "send": [1], "label": "next"},

	{"component": "input", "plugin": "codec", "send": [2], "label": "state"},

	{"component": "input", "plugin": "codec", "send": [3], "label": "letter"},

	{"component": "associator", "send": [11], "receive": [1, [2, 11], 3], "threshold": 0.7},

	{"component": "output", "plugin": "codec", "receive": [11], "label": "next"}
  ]
}