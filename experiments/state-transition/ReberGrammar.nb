Cell["\<\
jsonstr = 

{ \"hyperparameters\": {\"default\": [2000, 10], \"12\": [2000, 0]},
  \"dataflow\": [
\t{\"component\": \"input\", \"plugin\": \"codec\", \"send\": [1], \"label\": \
\"S'\[LineSeparator]\"},
\t{\"component\": \"input\", \"plugin\": \"codec\", \"send\": [3], \"label\": \
\"S\"},
\t{\"component\": \"input\", \"plugin\": \"codec\", \"send\": [4], \"label\": \
\"letter\"},
\t{\"component\": \"empty\", \"send\": [2]},
\t{\"component\": \"transition\", \"send\": [11, 12], \"threshold\": 1.0,
\t\t\"receive\": [1, 2, [{\"slot\": 3, \"tags\": [\"priority\"]}, 11], 4]},
\t{\"component\": \"output\", \"plugin\": \"codec\", \"receive\": [11], \
\"label\": \"S\"}
  ]}
\
\>", "Program",ExpressionUUID->"f75a62f0-00c7-4604-8e8a-1d55d1594d95"],

