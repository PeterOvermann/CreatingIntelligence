Cell["\<\
jsonstr = 

{
  \"$schema\": \"https://creatingintelligence.org/schemas/circuit-v1.json\",

  \"hyperparameters\": {\"default\": [2000, 10]},

  \"dataflow\": [
\t{\"component\": \"input\", \"plugin\": \"codec\", \"send\": [1], \"label\": \
\"next\"},

\t{\"component\": \"input\", \"plugin\": \"codec\", \"send\": [2], \"label\": \
\"state\"},

\t{\"component\": \"input\", \"plugin\": \"codec\", \"send\": [3], \"label\": \
\"letter\"},

\t{\"component\": \"associator\", \"send\": [11], \"receive\": [1, [2, 11], \
3], \"threshold\": 0.7},

\t{\"component\": \"output\", \"plugin\": \"codec\", \"receive\": [11], \
\"label\": \"next\"}
  ]
}\
\>", "Program",
 GeneratedCell->True,
 CellAutoOverwrite->
  True,ExpressionUUID->"f7a318d7-5b6c-4986-a7bb-a6be4e3f85b1"],

