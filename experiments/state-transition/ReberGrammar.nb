Cell[CellGroupData[{

Cell["Train", "Subsection",ExpressionUUID->"43b23ddc-096d-451f-92cd-c27b2a89dbd7"],

Cell["\<\
Each rule once. The start state input carries the rule\[CloseCurlyQuote]s \
state and, tagged \[OpenCurlyDoubleQuote]priority\[CloseCurlyDoubleQuote], \
overrides the fed-back state.\
\>", "Text",ExpressionUUID->"6f737456-fae8-4996-be8f-89cb7769607b"],

Cell[BoxData[
 RowBox[{"Scan", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{
      RowBox[{"#", "[", 
       RowBox[{"[", "3", "]"}], "]"}], ",", " ", 
      RowBox[{"#", "[", 
       RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
      RowBox[{"#", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], "]"}], " ", "&"}], ",", " ", 
   "grammar"}], "]"}]], "Code",
 CellLabel->
  "In[288]:=",ExpressionUUID->"d1e2c6d5-9295-420f-9498-3927ef0f8727"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Test setup", "Subsection",ExpressionUUID->"6d1d0d98-8287-4158-b896-720fec19b76d"],

Cell["Reference recognizer, used only to label the test strings.", "Text",ExpressionUUID->"597dbe00-d4fd-485f-bf97-d3447f3a8ef3"],

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{"table", " ", "=", " ", 
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#1", ",", " ", "#2"}], "}"}], " ", "->", " ", "#3"}], 
         ")"}], " ", "&"}], " ", "@@@", " ", "grammar"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"grammaticalQ", "[", "s_String", "]"}], " ", ":=", "\n", "  ", 
     RowBox[{
      RowBox[{"Fold", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Lookup", "[", 
          RowBox[{"table", ",", " ", 
           RowBox[{"Key", "[", 
            RowBox[{"{", 
             RowBox[{"#1", ",", " ", "#2"}], "}"}], "]"}], ",", " ", 
           RowBox[{"Missing", "[", "]"}]}], "]"}], " ", "&"}], ",", " ", "\n",
         "  ", "\"\<begin\>\"", ",", " ", 
        RowBox[{"Characters", "[", "s", "]"}]}], "]"}], " ", "===", 
      " ", "\"\<end\>\""}]}], ";"}]}]}]], "Code",
 CellLabel->
  "In[289]:=",ExpressionUUID->"68870931-d610-4b7e-8875-dcbd60c1a3d5"],

Cell["Grammatical strings: random walk through the grammar.", "Text",ExpressionUUID->"e0ce84c5-1a81-4201-9859-f76fd5d1667a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"generate", "[", "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"state", " ", "=", " ", "\"\<begin\>\""}], ",", " ", 
      RowBox[{"letters", " ", "=", " ", 
       RowBox[{"{", "}"}]}], ",", " ", "rule"}], "}"}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"state", " ", "=!=", " ", "\"\<end\>\""}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"rule", " ", "=", " ", 
         RowBox[{"RandomChoice", "[", 
          RowBox[{"Select", "[", 
           RowBox[{"grammar", ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"First", "[", "#", "]"}], " ", "===", " ", "state"}], 
             " ", "&"}]}], "]"}], "]"}]}], ";", "\n", "    ", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"letters", ",", " ", 
          RowBox[{"rule", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ";", "\n", "    ", 
        RowBox[{"state", " ", "=", " ", 
         RowBox[{"rule", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}]}]}], "]"}], ";", "\n", "  ", 
     RowBox[{"StringJoin", "[", "letters", "]"}]}]}], "]"}]}]], "Code",
 CellLabel->
  "In[291]:=",ExpressionUUID->"d59713c1-04c7-4ab3-971b-96cbe6ac6c46"],

Cell["\<\
Ungrammatical strings: substitute one inner letter until the string leaves \
the grammar.\
\>", "Text",ExpressionUUID->"64a88171-801c-42c9-a38f-c240d5febfb1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"randomSubstitution", "[", "s_String", "]"}], " ", ":=", " ", "\n",
    "\t", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"i", " ", "=", " ", 
       RowBox[{"RandomInteger", "[", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", 
          RowBox[{
           RowBox[{"StringLength", "[", "s", "]"}], " ", "-", " ", "1"}]}], 
         "}"}], "]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"StringReplacePart", "[", 
      RowBox[{"s", ",", "\n", "      ", 
       RowBox[{"RandomChoice", "[", 
        RowBox[{"DeleteCases", "[", 
         RowBox[{
          RowBox[{"Characters", "[", "\"\<TPSXV\>\"", "]"}], ",", " ", "\n", 
          "      ", 
          RowBox[{"StringTake", "[", 
           RowBox[{"s", ",", " ", 
            RowBox[{"{", "i", "}"}]}], "]"}]}], "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "i"}], "}"}]}], "]"}]}], "]"}]}], ";"}], "\n", 

 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    RowBox[{"substitute", "[", "s_String", "]"}], " ", ":=", " ", 
    RowBox[{"NestWhile", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"randomSubstitution", "[", "s", "]"}], " ", "&"}], ",", " ", 
      "\n", "  ", "s", ",", " ", "grammaticalQ"}], "]"}]}], ";"}]}]}], "Code",\
ExpressionUUID->"6a9a2e8d-c7f0-4dd7-8345-0c4f6463cd8f"],

Cell["\<\
Run the automaton: the first letter comes with the start state, the remaining \
letters arrive alone.\
\>", "Text",ExpressionUUID->"1adc820b-e47a-4dd7-bee3-404c79aa68a3"],

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"trace", "[", "s_String", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"letters", " ", "=", " ", 
          RowBox[{"Characters", "[", "s", "]"}]}], ",", " ", "first"}], "}"}],
        ",", "\n", "  ", 
       RowBox[{
        RowBox[{"first", " ", "=", " ", 
         RowBox[{"f", "[", 
          RowBox[{
           RowBox[{"{", "}"}], ",", " ", "\"\<begin\>\"", ",", " ", 
           RowBox[{"First", "[", "letters", "]"}]}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"Prepend", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"f", "[", 
             RowBox[{
              RowBox[{"{", "}"}], ",", " ", 
              RowBox[{"{", "}"}], ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@",
            " ", 
           RowBox[{"Rest", "[", "letters", "]"}]}], ",", " ", "first"}], 
         "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"acceptedQ", "[", "s_String", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"Last", "[", 
       RowBox[{"trace", "[", "s", "]"}], "]"}], " ", "===", 
      " ", "\"\<end\>\""}]}], ";"}]}]}]], "Code",
 CellLabel->
  "In[292]:=",ExpressionUUID->"e75f57b0-10eb-4757-b483-8545b63c359a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Generate test data", "Subsection",ExpressionUUID->"1aa32cba-01d0-452e-ae8b-f35ed4c4f938"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"positives", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"generate", "[", "]"}], ",", " ", "500"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"negatives", " ", "=", " ", 
   RowBox[{"substitute", " ", "/@", " ", "positives"}]}], ";"}]}], "Code",
 CellLabel->
  "In[294]:=",ExpressionUUID->"85e18a20-c2e9-41aa-aa5e-de54f71e03c9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Run", "Subsection",ExpressionUUID->"36da18a8-bdfa-4e63-a1c1-044b32097d66"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"s", ",", " ", "\"\<   \>\"", ",", "\n", "    ", 
       RowBox[{"StringRiffle", "[", 
        RowBox[{
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
            "#1", " ", "<>", " ", "\"\<:\>\"", " ", "<>", " ", "\n", "    ", 
             RowBox[{"ToString", "[", 
              RowBox[{"Replace", "[", 
               RowBox[{"#2", ",", " ", 
                RowBox[{"Null", " ", "->", " ", "\"\<-\>\""}]}], "]"}], 
              "]"}]}], " ", "&"}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Characters", "[", "s", "]"}], ",", " ", 
             RowBox[{"trace", "[", "s", "]"}]}], "}"}]}], "]"}], ",", 
         " ", "\"\< \>\""}], "]"}], ",", "\n", "    ", "\"\<   \>\"", ",", 
       " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"acceptedQ", "[", "s", "]"}], ",", " ", "\"\<accepted\>\"", ",",
          " ", "\"\<rejected\>\""}], "]"}]}], "]"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Take", "[", 
          RowBox[{"positives", ",", " ", "3"}], "]"}], ",", " ", 
         RowBox[{"Take", "[", 
          RowBox[{"negatives", ",", " ", "3"}], "]"}]}], "]"}]}], "}"}]}], 
    "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<grammatical accepted:   \>\"", ",", " ", "\n", "\t", 
    RowBox[{"Count", "[", 
     RowBox[{"positives", ",", " ", 
      RowBox[{"_", "?", "acceptedQ"}]}], "]"}], ",", " ", "\"\</500\>\""}], 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<ungrammatical rejected: \>\"", ",", " ", "\n", "\t", 
    RowBox[{"Count", "[", 
     RowBox[{"negatives", ",", " ", 
      RowBox[{"_", "?", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"!", " ", 
          RowBox[{"acceptedQ", "[", "#", "]"}]}], " ", "&"}], ")"}]}]}], 
     "]"}], ",", " ", "\"\</500\>\""}], "]"}], ";"}]}], "Code",ExpressionUUID->\
"4284c2f9-c934-4ca6-b343-c9b6b2875dc8"],

