Cell[CellGroupData[{

Cell["Train", "Subsection",ExpressionUUID->"43b23ddc-096d-451f-92cd-c27b2a89dbd7"],

Cell["\<\
Each rule once. An empty cycle follows each rule, so the next rule starts \
without a fed-back state.\
\>", "Text",ExpressionUUID->"6f737456-fae8-4996-be8f-89cb7769607b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Scan", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "3", "]"}], "]"}], ",", " ", 
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ";", " ", 
       RowBox[{"f", "[", 
        RowBox[{
         RowBox[{"{", "}"}], ",", " ", 
         RowBox[{"{", "}"}], ",", " ", 
         RowBox[{"{", "}"}]}], "]"}]}], ")"}], " ", "&"}], ",", " ", 
    "grammar"}], "]"}], ";"}]], "Code",
 CellLabel->
  "In[344]:=",ExpressionUUID->"d1e2c6d5-9295-420f-9498-3927ef0f8727"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Datasets", "Subsection",ExpressionUUID->"76a9532f-78ca-4b9e-bf42-5ec97439b0aa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"n", " ", "=", " ", "1000"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"valid", " ", "=", " ", 
   RowBox[{"Take", "[", 
