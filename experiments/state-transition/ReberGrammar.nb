  ";"}]}], "Code",
 CellLabel->
  "In[345]:=",ExpressionUUID->"897b279b-6818-4413-9bdf-e3f36152ed7e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Test setup", "Subsection",ExpressionUUID->"6d1d0d98-8287-4158-b896-720fec19b76d"],

Cell["\<\
Run the automaton: the first letter comes with the start state \
\[OpenCurlyDoubleQuote]end\[CloseCurlyDoubleQuote], the remaining letters \
arrive alone.\
\>", "Text",ExpressionUUID->"597dbe00-d4fd-485f-bf97-d3447f3a8ef3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"trace", "[", "s_String", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"letters", " ", "=", " ", 
        RowBox[{"Characters", "[", "s", "]"}]}], ",", " ", "first"}], "}"}], ",",
      "\n", "  ", 
     RowBox[{
      RowBox[{"first", " ", "=", " ", 
       RowBox[{"f", "[", 
        RowBox[{
         RowBox[{"{", "}"}], ",", " ", "\"\<end\>\"", ",", " ", 
         RowBox[{"First", "[", "letters", "]"}]}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"Prepend", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"f", "[", 
           RowBox[{
            RowBox[{"{", "}"}], ",", " ", 
            RowBox[{"{", "}"}], ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@",
          " ", 
         RowBox[{"Rest", "[", "letters", "]"}]}], ",", " ", "first"}], 
       "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"acceptedQ", "[", "s_String", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Last", "[", 
     RowBox[{"trace", "[", "s", "]"}], "]"}], " ", "===", 
    " ", "\"\<end\>\""}]}], ";"}]}], "Code",
 CellLabel->
  "In[348]:=",ExpressionUUID->"68870931-d610-4b7e-8875-dcbd60c1a3d5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Run", "Subsection",ExpressionUUID->"36da18a8-bdfa-4e63-a1c1-044b32097d66"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"s", ",", " ", "\"\<   \>\"", ",", "\n", "    ", 
       RowBox[{"StringRiffle", "[", 
        RowBox[{
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#1", " ", "<>", " ", "\"\<:\>\"", " ", "<>", " ", 
             RowBox[{"ToString", "[", 
              RowBox[{"Replace", "[", 
               RowBox[{"#2", ",", " ", 
                RowBox[{"Null", " ", "->", " ", "\"\<-\>\""}]}], "]"}], 
              "]"}]}], " ", "&"}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Characters", "[", "s", "]"}], ",", " ", 
             RowBox[{"trace", "[", "s", "]"}]}], "}"}]}], "]"}], ",", 
         " ", "\"\< \>\""}], "]"}], ",", "\n", "    ", "\"\<   \>\"", ",", 
       " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"acceptedQ", "[", "s", "]"}], ",", " ", "\"\<accepted\>\"", ",",
          " ", "\"\<rejected\>\""}], "]"}]}], "]"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Take", "[", 
          RowBox[{"valid", ",", " ", "3"}], "]"}], ",", " ", 
         RowBox[{"Take", "[", 
          RowBox[{"invalid", ",", " ", "3"}], "]"}]}], "]"}]}], "}"}]}], 
    "]"}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Grammatical", " ", "and", " ", "ungrammatical", " ", "strings", " ", 
     "alternate"}], ",", " ", 
    RowBox[{
    "so", " ", "that", " ", "every", "\n", "   ", "rejected", " ", "string", " ",
      "is", " ", "followed", " ", "by", " ", "a", " ", "string", " ", "that", 
     " ", "must", " ", "be", " ", "accepted"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"results", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"acceptedQ", "[", 
         RowBox[{"valid", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", " ", 
        RowBox[{"acceptedQ", "[", 
         RowBox[{"invalid", "[", 
