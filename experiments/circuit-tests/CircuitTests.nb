[\\n\\t{\\\"component\\\": \\\"input\\\", \\\"send\\\": \
[11]},\\n\\t{\\\"component\\\": \\\"delay\\\", \\\"send\\\": [21], \
\\\"receive\\\": [11]},\\n\\t{\\\"component\\\": \\\"delay\\\", \\\"send\\\": \
[31], \\\"receive\\\": [{\\\"slot\\\": 21, \\\"tags\\\": [\\\"log\\\"]}]},\\n\
\\t{\\\"component\\\": \\\"output\\\", \\\"receive\\\": [31]}\\n  ]}\"\>",
