     "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"input", "[", "]"}], "[", "12", "]"}], "[", "]"}], ",", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "]"}], "[", "]"}], "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"11", "\"\<k\>\""}], ",", 
