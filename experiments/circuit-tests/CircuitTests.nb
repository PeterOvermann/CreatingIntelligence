Cell["Learn A -> B:", "Text",ExpressionUUID->"5d134b50-7cb5-4d7c-90a6-f938df14d4a6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"test", "[", 
   RowBox[{"\"\<A\>\"", ",", " ", "\"\<B\>\""}], "]"}], "[", "\"\<B\>\"", 
  "]"}]], "Code",
 CellLabel->
  "In[2013]:=",ExpressionUUID->"3a74d029-8bd3-4eeb-80b5-d542bf4b8bf5"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     FrameBox[
      StyleBox["\<\"> A, B\\nB\"\>",
