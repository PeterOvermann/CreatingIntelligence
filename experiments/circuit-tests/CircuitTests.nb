     RowBox[{"21", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "5"}], "}"}]}]}], "\n", "\t", "}"}], ",", 
   " ", "200"}], "]"}]], "Code",
 CellLabel->
  "In[104]:=",ExpressionUUID->"2c5e1bad-d32e-418e-ba2d-68637d6c694c"],

