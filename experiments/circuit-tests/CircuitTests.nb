     "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "]"}], "[", "]"}], "[", 
      RowBox[{"11", "\"\<R\>\""}], "]"}], ",", " ", "\n", "\t", 
     RowBox[{"_", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", "5"}], "}"}]}]}], "\n", "\t", "}"}], ",", " ", 
   "120"}], "]"}]], "Code",
