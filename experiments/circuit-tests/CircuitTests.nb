       RowBox[{"delay", "[", " ", 
        RowBox[{
         RowBox[{"\"\<latch\>\"", "->", "True"}], ",", " ", 
         RowBox[{"\"\<threshold\>\"", " ", "->", " ", "0.8"}]}], "]"}], "[", 
       "21", "]"}], "[", "11", "]"}], ",", "\n", "\t", 
