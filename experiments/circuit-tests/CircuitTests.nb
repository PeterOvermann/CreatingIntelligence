      RowBox[{
       RowBox[{"input", "[", "]"}], "[", "11", "]"}], "[", "]"}], ",", " ", 
     "\n", "  \t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "]"}], "[", "]"}], "[", 
      RowBox[{"11", " ", "\"\<R\>\""}], "]"}], ",", " ", "\n", "  \t", 
     RowBox[{"11", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "5"}], "}"}]}]}], "\n", "  \t", "}"}], ",", 
   " ", "120"}], "]"}]], "Code",
 CellLabel->
