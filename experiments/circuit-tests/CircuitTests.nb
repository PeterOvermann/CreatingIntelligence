      RowBox[{"11", "\"\<k+\>\""}], "]"}], ",", "\n", "\t", 
     RowBox[{"_", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "5"}], "}"}]}]}], " ", 
    RowBox[{"(*", " ", 
