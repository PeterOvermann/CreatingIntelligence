Cell["\<\
By default, an auto-associative item store learns a new pattern only if its \
length matches the population specified in the outgoing path. Here we specify \
a custom range:\
\>", "Text",ExpressionUUID->"22e0608d-7829-4df4-b965-968eb22d04ea"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dataflow", "[", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"input", "[", "]"}], " ", "[", "11", "]"}], " ", "[", "]"}], ",",
      " ", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"auto", "[", 
        RowBox[{"\"\<learn\>\"", "->", " ", 
         RowBox[{"{", 
          RowBox[{"1.0", ",", " ", "1.5"}], "}"}]}], "]"}], " ", "[", "21", 
       "]"}], " ", "[", "11", "]"}], ",", " ", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "]"}], " ", "[", "]"}], " ", "[", "21", "]"}], ",",
      "\n", "\t", 
     RowBox[{"_", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "10"}], "}"}]}]}], "\n", "\t", "}"}], ",", 
   " ", "200"}], "]"}]], "Code",
 CellLabel->
  "In[771]:=",ExpressionUUID->"16cd1b34-6cb5-44b6-a3a6-1b05d31a3190"],

Cell[BoxData[
 FrameBox[
  TagBox[GridBox[{
     {
      StyleBox[
       TagBox["\<\"{ \\\"hyperparameters\\\": {\\\"default\\\": [1000, \
10]},\\n  \\\"dataflow\\\": [\\n\\t{\\\"component\\\": \\\"input\\\", \
\\\"send\\\": [11]},\\n\\t{\\\"component\\\": \\\"auto\\\", \\\"send\\\": \
[21], \\\"receive\\\": [11], \\\"learn\\\": [1.0, \
1.5]},\\n\\t{\\\"component\\\": \\\"output\\\", \\\"receive\\\": [21]}\\n  ]}\
\"\>",
        Function[BoxForm`e$, 
         TableForm[BoxForm`e$, TableSpacing -> {2, 1}]]],
       StripOnInput->False,
       LineColor->GrayLevel[0],
       FrontFaceColor->GrayLevel[0],
       BackFaceColor->GrayLevel[0],
       GraphicsColor->GrayLevel[0],
       FontFamily->"JetBrains Mono",
       FontSize->10,
       FontColor->GrayLevel[0]]},
     {
      TemplateBox[{10, 5},
       "Spacer2"]},
     {
      TemplateBox[{
        TemplateBox[{18}, "Spacer1"], 
        StyleBox[
         GraphicsBox[
          NamespaceBox["NetworkGraphics", 
           DynamicModuleBox[{Typeset`graph = HoldComplete[
               
               Graph[{1, 2, 3}, {{{1, 2}, {2, 3}}, Null, {"", ""}}, {
                BaseStyle -> {FontFamily -> "Inter Variable", 
                   Opacity[1]}, 
                 EdgeLabels -> {
                  DirectedEdge[1, 2, ""] -> None, DirectedEdge[2, 3, ""] -> 
                   None}, EdgeStyle -> {DirectedEdge[1, 2, ""] -> Directive[
                    RGBColor[
                    0.1803921568627451, 0.20392156862745098`, 
