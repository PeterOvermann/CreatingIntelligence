                  DirectedEdge[1, 2, ""] -> None, DirectedEdge[2, 3, ""] -> 
                   None}, EdgeStyle -> {DirectedEdge[1, 2, ""] -> Directive[
                    RGBColor[
                    0.1803921568627451, 0.20392156862745098`, 
                    0.25098039215686274`], 
                    Opacity[1], 
                    AbsoluteThickness[0.5]], DirectedEdge[2, 3, ""] -> 
                   Directive[
                    RGBColor[
                    0.1803921568627451, 0.20392156862745098`, 
                    0.25098039215686274`], 
                    Opacity[1], 
                    AbsoluteThickness[0.5]]}, 
                 GraphLayout -> {
                  "LayeredDigraphEmbedding", "Orientation" -> Left}, 
                 ImageSize -> 200, PlotTheme -> "Classic", 
                 VertexCoordinates -> {{1, 0}, {2, 0}, {3, 0}}, 
                 VertexLabels -> {2 -> Placed[
                    Style["\[FilledDownTriangle]", 
                    RGBColor[
                    0.1803921568627451, 0.20392156862745098`, 
                    0.25098039215686274`], 18, Bold], Center], 1 -> Placed[
                    Style["", 
                    RGBColor[
                    0.1803921568627451, 0.20392156862745098`, 
                    0.25098039215686274`], 10, Bold], Center], 3 -> Placed[
                    Style["", 
                    RGBColor[
                    0.1803921568627451, 0.20392156862745098`, 
                    0.25098039215686274`], 10, Bold], Center]}, 
                 VertexShapeFunction -> {
                  3 -> "Circle", 1 -> "Circle", 2 -> "Square"}, 
                 VertexSize -> {0.4}, VertexStyle -> {3 -> Directive[
                    RGBColor[
                    0.9254901960784314, 0.9372549019607843, 
                    0.9568627450980393], 
                    EdgeForm[
                    Directive[
                    RGBColor[
                    0.23137254901960785`, 0.25882352941176473`, 
                    0.3215686274509804], 
                    AbsoluteThickness[0.15]]], 
                    Opacity[1]], 1 -> Directive[
                    RGBColor[
                    0.9254901960784314, 0.9372549019607843, 
                    0.9568627450980393], 
                    EdgeForm[
                    Directive[
                    RGBColor[
                    0.23137254901960785`, 0.25882352941176473`, 
                    0.3215686274509804], 
                    AbsoluteThickness[0.15]]], 
                    Opacity[1]], 2 -> Directive[
