      RowBox[{
       RowBox[{"input", "[", "codec", "]"}], " ", "[", "11", "]"}], " ", "[", 
      "]"}], ",", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"auto", "[", 
        RowBox[{"complement", ",", 
         RowBox[{"\"\<learn\>\"", "->", 
          RowBox[{"{", 
           RowBox[{"1.0", ",", "10.0"}], "}"}]}]}], "]"}], " ", "[", "21", 
       "]"}], " ", "[", 
      RowBox[{"{", 
       RowBox[{"11", ",", "21"}], "}"}], "]"}], ",", " ", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "codec", "]"}], " ", "[", "]"}], " ", "[", "21",
       "]"}], ",", "\n", "\t", 
     RowBox[{"_", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "10"}], "}"}]}]}], "\n", "\t", "}"}], ",", 
   " ", "200"}], "]"}]], "Code",
 CellLabel->
  "In[16281]:=",ExpressionUUID->"98659c23-c5fd-4dfd-9567-8d69c14e2003"],

Cell[BoxData[
 FrameBox[
  TagBox[GridBox[{
     {
