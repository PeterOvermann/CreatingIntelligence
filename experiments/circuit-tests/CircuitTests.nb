       TagBox["\<\"{ \\\"hyperparameters\\\": {\\\"default\\\": [1000, \
10]},\\n  \\\"dataflow\\\": [\\n\\t{\\\"component\\\": \\\"input\\\", \
\\\"plugin\\\": \\\"codec\\\", \\\"send\\\": [11]},\\n\\t{\\\"component\\\": \
\\\"input\\\", \\\"plugin\\\": \\\"codec\\\", \\\"send\\\": \
