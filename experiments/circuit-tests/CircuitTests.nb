Cell["\<\
The following shows a reverberatory circuit that bounces signals between two \
delay nodes, toggling  two states in the absence of new input. As the \
incoming pathway takes priority over the feedback, no rate decimation is \
needed.\
\>", "Text",ExpressionUUID->"e9414c0a-96f0-4db1-918d-fa10d5921e18"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dataflow", "[", 
  RowBox[{
   RowBox[{"{", "\n", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"input", "[", "]"}], "[", "11", "]"}], "[", "]"}], ",", " ", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"delay", "[", "]"}], "[", "21", "]"}], "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"11", "\"\<!\>\""}], ",", " ", "22"}], "}"}], "]"}], ",", 
     "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"delay", "[", "]"}], "[", "22", "]"}], "[", "21", "]"}], ",", 
     "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "]"}], "[", "]"}], "[", "21", "]"}], ",", "\n", 
     "\t", 
     RowBox[{"_", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "5"}], "}"}]}]}], "\n", "\t", "}"}], ",", 
   " ", "200"}], "]"}]], "Code",
 CellLabel->
  "In[196]:=",ExpressionUUID->"3c552589-84c2-422e-bbc2-5bec938f53e1"],

