\\\"plugin\\\": \\\"category\\\", \\\"send\\\": [11], \\\"categories\\\": \
10},\\n\\t{\\\"component\\\": \\\"output\\\", \\\"receive\\\": [11]}\\n  ]}\"\
\>",
