Cell[CellGroupData[{

Cell["Temporal Integration", "Section",ExpressionUUID->"37383ec7-62fd-4af2-b6d4-4f22fe6e5dc5"],

Cell["\<\
The \[OpenCurlyDoubleQuote]delay\[CloseCurlyDoubleQuote] circuit component \
can accumulate  signals up to a configurable temporal capacity. The update \
behavior is governed by the choice of the update rule plugin. \
\>", "Text",ExpressionUUID->"b946c027-9381-4d70-9459-bc0f4921ce96"],

Cell["\<\
In this example, the internal capacity is twice the default population:\
\>", "Text",ExpressionUUID->"a7a99e3e-cab8-4dde-a6d8-458c673e8814"],

