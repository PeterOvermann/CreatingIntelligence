      " ", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"heteroencoder", "[", "]"}], "[", "101", "]"}], "[", "11", 
      "]"}], ",", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "]"}], " ", "[", "]"}], " ", "[", "101", "]"}], 
     ",", "\n", "\t", 
