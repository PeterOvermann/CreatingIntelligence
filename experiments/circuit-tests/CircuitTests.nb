Cell["\<\
Below is an item memory for sparse distributed representations (SDRs), using \
an explicit threshold setting. As no update rule is specified in the \
auto-associative memory component, the default \
\[OpenCurlyDoubleQuote]replacement\[CloseCurlyDoubleQuote] is assumed. \
\>", "Text",ExpressionUUID->"e3b5c163-c93d-4a97-93e1-543c8310898f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dataflow", "[", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"input", "[", "]"}], " ", "[", "11", "]"}], " ", "[", "]"}], ",",
      " ", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"auto", "[", 
        RowBox[{"\"\<threshold\>\"", " ", "->", " ", "1.0"}], "]"}], " ", "[",
        "21", "]"}], " ", "[", "11", "]"}], ",", " ", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"output", "[", "]"}], " ", "[", "]"}], " ", "[", "21", "]"}], ",",
      "\n", "\t", 
     RowBox[{"_", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1000", ",", " ", "10"}], "}"}]}]}], "\n", "\t", "}"}], ",", 
   " ", "200"}], "]"}]], "Code",
 CellLabel->
  "In[234]:=",ExpressionUUID->"2362c395-e614-450e-bc5c-0ed7ac758905"],

Cell[BoxData[
 FrameBox[
  TagBox[GridBox[{
     {
      StyleBox[
       TagBox["\<\"{ \\\"hyperparameters\\\": {\\\"default\\\": [1000, \
10]},\\n  \\\"dataflow\\\": [\\n\\t{\\\"component\\\": \\\"input\\\", \
\\\"send\\\": [11]},\\n\\t{\\\"component\\\": \\\"auto\\\", \\\"send\\\": \
[21], \\\"receive\\\": [11], \\\"threshold\\\": \
1.0},\\n\\t{\\\"component\\\": \\\"output\\\", \\\"receive\\\": [21]}\\n  \
]}\"\>",
        Function[BoxForm`e$, 
         TableForm[BoxForm`e$, TableSpacing -> {2, 1}]]],
       StripOnInput->False,
       LineColor->GrayLevel[0],
       FrontFaceColor->GrayLevel[0],
       BackFaceColor->GrayLevel[0],
       GraphicsColor->GrayLevel[0],
       FontFamily->"JetBrains Mono",
       FontSize->10,
       FontColor->GrayLevel[0]]},
     {
      TemplateBox[{10, 5},
       "Spacer2"]},
     {
      TemplateBox[{
        TemplateBox[{18}, "Spacer1"], 
        StyleBox[
         GraphicsBox[
          NamespaceBox["NetworkGraphics", 
           DynamicModuleBox[{Typeset`graph = HoldComplete[
               
               Graph[{1, 2, 3}, {{{1, 2}, {2, 3}}, Null, {"", ""}}, {
                BaseStyle -> {FontFamily -> "Inter Variable", 
                   Opacity[1]}, 
                 EdgeLabels -> {
                  DirectedEdge[1, 2, ""] -> None, DirectedEdge[2, 3, ""] -> 
                   None}, EdgeStyle -> {DirectedEdge[1, 2, ""] -> Directive[
                    RGBColor[
                    0.1803921568627451, 0.20392156862745098`, 
