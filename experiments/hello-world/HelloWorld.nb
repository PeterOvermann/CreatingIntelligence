Cell["Hello World", "Title",ExpressionUUID->"d073459d-127b-439c-b315-94de6963b699"],

Cell["Setting up a basic circuit", "Subtitle",ExpressionUUID->"74e7b6e8-0439-46d3-8fb5-ca078b2a5326"],

Cell["\<\
This circuit encodes an input token as an SHR, routes it directly to the \
output, and decodes the result.
The encoded data is logged  to the console.\
\>", "Text",ExpressionUUID->"86cc569a-be37-4aff-8a57-73ac76739a7f"],

