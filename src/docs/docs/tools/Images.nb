Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{"SetDirectory", "[", 
     RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"generate", "[", " ", 
     RowBox[{"net_List", ",", " ", "filename_String", " ", ",", " ", 
      RowBox[{"size_", " ", ":", " ", "240"}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"circ", ",", " ", "graph", ",", " ", "img", ",", " ", "str"}], 
       "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"str", " ", "=", " ", 
        RowBox[{"ToJSON", "[", 
         RowBox[{"KeyDrop", "[", 
          RowBox[{
           RowBox[{"FromDFD", "[", "net", "]"}], ",", 
           " ", "\"\<$schema\>\""}], "]"}], "]"}]}], ";", "\n", "\t", "\n", 
       "\t", 
       RowBox[{"(*", " ", 
        RowBox[{"Compactify", " ", 
         RowBox[{"JSON", "."}]}], " ", "*)"}], "\n", "\t", 
       RowBox[{"str", " ", "=", " ", 
        RowBox[{"StringReplace", "[", 
         RowBox[{"str", ",", " ", 
          RowBox[{"\"\<{\\n  \\\"\>\"", " ", "->", " ", "\"\<{ \\\"\>\""}]}], 
         "]"}]}], ";", "\n", "\t", 
       RowBox[{"str", " ", "=", " ", 
        RowBox[{"StringReplace", "[", 
         RowBox[{"str", ",", " ", 
          RowBox[{"\"\<  ]\\n}\>\"", " ", "->", " ", "\"\<  ]}\>\""}]}], 
         "]"}]}], ";", "\n", "\t", 
       RowBox[{"str", " ", "=", " ", 
        RowBox[{"StringReplace", "[", 
         RowBox[{"str", ",", " ", 
          RowBox[{"\"\<\\n\\n\>\"", " ", "->", " ", "\"\<\\n\>\""}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", "    ", 
       RowBox[{"str", " ", "=", " ", 
        RowBox[{"str", " ", "<>", " ", "\"\<\\n\>\""}]}], ";", "\n", "    ", 
       "\n", "    ", 
       RowBox[{"str", " ", "=", " ", 
        RowBox[{"\"\<```json\\n\>\"", " ", "<>", " ", "str", " ", "<>", 
         " ", "\"\<```\\n\>\""}]}], ";", "\n", "\n", "\t", 
       RowBox[{"CopyToClipboard", "[", "str", "]"}], ";", "\n", 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"circ", " ", "=", " ", 
        RowBox[{"Circuit", "[", "net", "]"}]}], ";", " ", 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"graph", " ", "=", " ", 
        RowBox[{
         RowBox[{"circ", "[", "\"\<schematics\>\"", "]"}], "[", 
         RowBox[{"ImageSize", "->", " ", "size"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "\t", 
       RowBox[{"img", " ", "=", " ", 
        RowBox[{"Rasterize", "[", 
         RowBox[{"graph", ",", " ", 
          RowBox[{"ImageResolution", "->", " ", "300"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"If", "[", " ", 
        RowBox[{
         RowBox[{"filename", " ", "=!=", " ", "\"\<\>\""}], ",", " ", 
         "\[IndentingNewLine]", "\t", 
         RowBox[{"Export", "[", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"NotebookDirectory", "[", "]"}], "<>", 
            " ", "\"\<../img/\>\"", " ", "<>", " ", "filename", " ", "<>", 
            " ", "\"\<.png\>\""}], ",", " ", "img", ",", " ", "\n", "\t\t", 
           RowBox[{"IncludeMetaInformation", "->", "None"}], ",", " ", 
           RowBox[{"CompressionLevel", "->", "1"}]}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "\t", 
       RowBox[{"circ", "[", "\"\<clear\>\"", "]"}], ";", 
       "\[IndentingNewLine]", "\t", "graph"}]}], "\[IndentingNewLine]", "\t", 
     "]"}]}]}]}]], "Code",
 CellLabel->
  "In[255]:=",ExpressionUUID->"8ad8121f-2252-4976-9ab1-c9cb6489b7e8"]
}, Open  ]],

