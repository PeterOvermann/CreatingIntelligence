        "Print", 
         "[", "\"\<Error: Save this notebook somewhere on your computer \
first.\>\"", "]"}], ";", "\n", "        ", 
        RowBox[{"Return", "[", "]"}]}]}], "\n", "    ", "]"}], ";", "\n", 
     "    ", "\n", "    ", 
     RowBox[{"(*", " ", 
      RowBox[{"Build", " ", 
       RowBox[{"library", "."}]}], " ", "*)"}], "\n", "    ", 
     RowBox[{"srcdir", " ", "=", " ", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
