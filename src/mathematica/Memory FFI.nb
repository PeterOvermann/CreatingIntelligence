     RowBox[{"nb", " ", "=", " ", 
      RowBox[{"EvaluationNotebook", "[", "]"}]}], ";", "\n", "    ", "\n", 
     "    ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Check", " ", "if", " ", "the", " ", "notebook", " ", "has", " ", 
       "been", " ", "saved", " ", "at", " ", "least", " ", "once", " ", "to", 
       " ", "have", " ", "a", " ", 
       RowBox[{"directory", "."}]}], " ", "*)"}], "\n", "    ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Quiet", "[", 
         RowBox[{"NotebookFileName", "[", "]"}], "]"}], " ", "===", " ", 
        "$Failed"}], ",", "\n", "        ", 
       RowBox[{
