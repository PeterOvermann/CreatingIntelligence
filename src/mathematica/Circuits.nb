   RowBox[{
    RowBox[{
     RowBox[{"Circuit", "::", "multinp"}], "   ", "=", 
     " ", "\"\<`1`: Expecting multiple input slots.\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Circuit", "::", "integer"}], "   ", "=", 
     " ", "\"\<Invalid data: `1`\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Circuit", "::", "circuit"}], "   ", "=", 
     " ", "\"\<`1`: Expecting embedded circuit.\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Circuit", "::", "embedded"}], "  ", "=", 
